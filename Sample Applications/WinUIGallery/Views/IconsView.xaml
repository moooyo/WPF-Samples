<UserControl x:Class="WPFGallery.Views.IconsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="using:WPFGallery.Models" x:DefaultBindMode="OneWay">
    <StackPanel Spacing="12">
        <TextBox Header="Search icons by name, code, or tag" AutomationProperties.AutomationId="IconSearch"
                 Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        <ComboBox Header="Icons per page" ItemsSource="{x:Bind ViewModel.PageSizes}"
                  SelectedIndex="{x:Bind ViewModel.SelectedPageSizeIndex, Mode=TwoWay}"
                  AutomationProperties.AutomationId="IconPageSize" />
        <StackPanel Orientation="Horizontal" Spacing="12">
            <Button Content="Previous" Command="{x:Bind ViewModel.PreviousPageCommand}" AutomationProperties.AutomationId="PreviousIconPage" />
            <Button Content="Next" Command="{x:Bind ViewModel.NextPageCommand}" AutomationProperties.AutomationId="NextIconPage" />
            <TextBlock Text="{x:Bind ViewModel.PageSummary, Mode=OneWay}" VerticalAlignment="Center"
                       AutomationProperties.AutomationId="IconPageSummary" />
        </StackPanel>
        <GridView Height="320" ItemsSource="{x:Bind ViewModel.DisplayedIcons, Mode=OneWay}"
                  SelectedItem="{x:Bind ViewModel.SelectedIcon, Mode=TwoWay}"
                  AutomationProperties.Name="Icons" AutomationProperties.AutomationId="IconGrid">
            <GridView.ItemTemplate>
                <DataTemplate x:DataType="models:IconData">
                    <StackPanel Width="144" Padding="8" Spacing="8">
                        <FontIcon Glyph="{x:Bind Character, Mode=OneTime}" FontSize="24" />
                        <TextBlock Text="{x:Bind Name, Mode=OneTime}" TextWrapping="Wrap" TextAlignment="Center" />
                    </StackPanel>
                </DataTemplate>
            </GridView.ItemTemplate>
        </GridView>
        <TextBlock Text="{x:Bind ViewModel.SelectedName}" FontWeight="SemiBold" />
        <TextBlock Text="{x:Bind ViewModel.SelectedGlyph}" IsTextSelectionEnabled="True" />
        <ItemsRepeater ItemsSource="{x:Bind ViewModel.SelectedTags}">
            <ItemsRepeater.Layout>
                <UniformGridLayout MinItemWidth="110" MinColumnSpacing="8" MinRowSpacing="8" />
            </ItemsRepeater.Layout>
            <ItemsRepeater.ItemTemplate>
                <DataTemplate x:DataType="x:String">
                    <Button Click="Tag_Click" Tag="{x:Bind Mode=OneTime}"
                            AutomationProperties.AutomationId="{x:Bind Mode=OneTime}">
                        <TextBlock Text="{x:Bind Mode=OneTime}" TextWrapping="Wrap" />
                    </Button>
                </DataTemplate>
            </ItemsRepeater.ItemTemplate>
        </ItemsRepeater>
        <Button Content="Copy icon glyph" Click="CopyGlyph_Click" AutomationProperties.AutomationId="CopyIconGlyph" />
        <TextBlock x:Name="StatusText" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
    </StackPanel>
</UserControl>
