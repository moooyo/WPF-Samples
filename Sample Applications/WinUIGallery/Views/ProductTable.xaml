<UserControl x:Class="WPFGallery.Views.ProductTable"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="using:WPFGallery.Models" x:DefaultBindMode="OneWay">
    <Grid RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="280" />
        </Grid.RowDefinitions>
        <Grid Padding="12,8" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="40" /><ColumnDefinition Width="*" />
                <ColumnDefinition Width="70" /><ColumnDefinition Width="80" /><ColumnDefinition Width="50" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="ID" FontWeight="SemiBold" />
            <TextBlock Grid.Column="1" Text="Product" FontWeight="SemiBold" />
            <TextBlock Grid.Column="2" Text="Quantity" FontWeight="SemiBold" />
            <TextBlock Grid.Column="3" Text="Price" FontWeight="SemiBold" />
            <TextBlock Grid.Column="4" Text="Stock" FontWeight="SemiBold" />
        </Grid>
        <ListView Grid.Row="1" ItemsSource="{x:Bind Products, Mode=OneTime}" AutomationProperties.Name="Products table"
                  AutomationProperties.AutomationId="ProductsTable" SelectionMode="Single">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:Product">
                    <Grid ColumnSpacing="8" Padding="0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40" /><ColumnDefinition Width="*" />
                            <ColumnDefinition Width="70" /><ColumnDefinition Width="80" /><ColumnDefinition Width="50" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{x:Bind Id, Mode=OneTime}" />
                        <TextBlock Grid.Column="1" Text="{x:Bind Name, Mode=OneTime}" TextWrapping="Wrap" />
                        <TextBlock Grid.Column="2" Text="{x:Bind Quantity, Mode=OneTime}" />
                        <TextBlock Grid.Column="3" Text="{x:Bind Price, Mode=OneTime}" />
                        <TextBlock Grid.Column="4" Text="{x:Bind Stock, Mode=OneTime}" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</UserControl>
