<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WPFGallery.Views.GalleryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:WPFGallery.Models" x:DefaultBindMode="OneWay">
    <Grid Padding="32,20,32,24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock Text="{x:Bind ViewModel.Title, Mode=OneWay}" Style="{StaticResource TitleTextBlockStyle}"
                   AutomationProperties.HeadingLevel="Level1" AutomationProperties.AutomationId="PageTitle" />
        <TextBlock Grid.Row="1" Text="{x:Bind ViewModel.Description, Mode=OneWay}" TextWrapping="Wrap" />
        <GridView x:Name="CatalogGrid" Grid.Row="2" ItemsSource="{x:Bind ViewModel.Items, Mode=OneWay}"
                  IsItemClickEnabled="True" SelectionMode="None" ItemClick="CatalogGrid_ItemClick"
                  AutomationProperties.Name="Controls and samples" AutomationProperties.AutomationId="CatalogGrid">
            <GridView.ItemTemplate>
                <DataTemplate x:DataType="models:ControlInfoDataItem">
                    <Grid Width="256" Height="208" Padding="16" RowSpacing="10"
                          Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                          BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="64" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Image Source="{x:Bind ImageSource, Mode=OneTime}" Height="56" HorizontalAlignment="Left"
                               AutomationProperties.AccessibilityView="Raw" />
                        <TextBlock Grid.Row="1" Text="{x:Bind Title, Mode=OneTime}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock Grid.Row="2" Text="{x:Bind Description, Mode=OneTime}" TextWrapping="Wrap" />
                    </Grid>
                </DataTemplate>
            </GridView.ItemTemplate>
        </GridView>
        <ScrollViewer x:Name="SampleScroll" Grid.Row="2" Visibility="Collapsed"
                      HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
            <StackPanel x:Name="SampleContent" Spacing="20" Padding="0,0,8,16" />
        </ScrollViewer>
    </Grid>
</Page>
