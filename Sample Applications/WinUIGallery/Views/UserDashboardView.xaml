<UserControl x:Class="WPFGallery.Views.UserDashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="using:WPFGallery.Models" x:DefaultBindMode="OneWay">
    <StackPanel Spacing="16">
        <CommandBar DefaultLabelPosition="Right">
            <AppBarButton Label="Add" Icon="Add" Command="{x:Bind ViewModel.AddCommand}" AutomationProperties.AutomationId="AddUser" />
            <AppBarButton Label="Edit" Icon="Edit" Command="{x:Bind ViewModel.EditCommand}" AutomationProperties.AutomationId="EditUser" />
            <AppBarButton Label="Save" Icon="Save" Command="{x:Bind ViewModel.SaveCommand}" AutomationProperties.AutomationId="SaveUser" />
            <AppBarButton Label="Cancel" Icon="Cancel" Command="{x:Bind ViewModel.CancelCommand}" AutomationProperties.AutomationId="CancelUser" />
            <AppBarButton Label="Delete" Icon="Delete" Click="Delete_Click" IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}"
                          AutomationProperties.AutomationId="DeleteUser" />
        </CommandBar>
        <ListView Height="220" ItemsSource="{x:Bind ViewModel.Users}" AutomationProperties.Name="Users"
                  IsEnabled="{x:Bind ViewModel.CanSelect, Mode=OneWay}" AutomationProperties.AutomationId="UserList"
                  SelectedItem="{x:Bind ViewModel.SelectedUser, Mode=TwoWay}">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:User">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <PersonPicture Width="40" Height="40" DisplayName="{x:Bind Name, Mode=OneWay}"
                                       ProfilePicture="{x:Bind ImageSource}" />
                        <StackPanel>
                            <TextBlock Text="{x:Bind Name, Mode=OneWay}" FontWeight="SemiBold" />
                            <TextBlock Text="{x:Bind Company, Mode=OneWay}" />
                        </StackPanel>
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        <TextBlock Text="User details" FontSize="20" AutomationProperties.HeadingLevel="Level2" />
        <ContentControl HorizontalContentAlignment="Stretch" IsEnabled="{x:Bind ViewModel.IsEditing, Mode=OneWay}">
        <StackPanel Spacing="12">
            <TextBox Header="First name" Text="{x:Bind ViewModel.Draft.FirstName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, FallbackValue=''}"
                     AutomationProperties.AutomationId="UserFirstName" />
            <TextBox Header="Last name" Text="{x:Bind ViewModel.Draft.LastName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, FallbackValue=''}"
                     AutomationProperties.AutomationId="UserLastName" />
            <TextBox Header="Company" Text="{x:Bind ViewModel.Draft.Company, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, FallbackValue=''}"
                     AutomationProperties.AutomationId="UserCompany" />
            <TextBox Header="Address" Text="{x:Bind ViewModel.Draft.Address, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, FallbackValue=''}"
                     AutomationProperties.AutomationId="UserAddress" />
            <NumberBox Header="Age" Value="{x:Bind ViewModel.Draft.Age, Mode=TwoWay, FallbackValue=0}" Minimum="0" Maximum="130"
                       AutomationProperties.AutomationId="UserAge" />
            <DatePicker Header="Date of joining" Date="{x:Bind ViewModel.DraftJoiningDate, Mode=TwoWay}"
                        AutomationProperties.AutomationId="UserJoiningDate" />
            <CheckBox Content="New graduate" IsChecked="{x:Bind ViewModel.Draft.IsNewGraduate, Mode=TwoWay, FallbackValue=False}"
                      AutomationProperties.AutomationId="UserNewGraduate" />
        </StackPanel>
        </ContentControl>
        <TextBlock Text="{x:Bind ViewModel.Status, Mode=OneWay}" TextWrapping="Wrap"
                   AutomationProperties.LiveSetting="Polite" AutomationProperties.AutomationId="UserStatus" />
    </StackPanel>
</UserControl>
