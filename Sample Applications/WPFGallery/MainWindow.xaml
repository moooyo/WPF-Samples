<winuiex:WindowEx
    x:Class="WPFGallery.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:winuiex="using:WinUIEx"
    Title="WPF Gallery"
    Width="1200" Height="800" MinWidth="780" MinHeight="470">
    <Grid x:Name="Root" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <NavigationView x:Name="Navigation" PaneTitle="WPF Gallery"
                        IsBackButtonVisible="Visible"
                        IsBackEnabled="{x:Bind ViewModel.CanNavigateback, Mode=OneWay}"
                        SelectionChanged="Navigation_SelectionChanged"
                        BackRequested="Navigation_BackRequested"
                        AutomationProperties.Name="Navigation Pane">
            <NavigationView.AutoSuggestBox>
                <AutoSuggestBox AutomationProperties.AutomationId="SearchBox" x:Name="SearchBox" PlaceholderText="Search samples"
                                QueryIcon="Find" TextChanged="SearchBox_TextChanged"
                                QuerySubmitted="SearchBox_QuerySubmitted"
                                DisplayMemberPath="Title" AutomationProperties.Name="Search samples" />
            </NavigationView.AutoSuggestBox>
            <Frame x:Name="RootContentFrame" Margin="24,16,24,0" Navigated="RootContentFrame_Navigated" />
        </NavigationView>
    </Grid>
</winuiex:WindowEx>
