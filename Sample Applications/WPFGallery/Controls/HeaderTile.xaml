<UserControl x:Class="WPFGallery.Controls.HeaderTile"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Width="198" Height="220">
    <Button AutomationProperties.AutomationId="RootButton" x:Name="RootButton" Margin="6" Padding="24" CornerRadius="8"
            HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
            HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
            AutomationProperties.Name="{x:Bind Title, Mode=OneWay}" Click="RootButton_Click">
        <Grid RowSpacing="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="56" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <ContentPresenter Content="{x:Bind Source, Mode=OneWay}" />
            <StackPanel Grid.Row="1" Spacing="8">
                <TextBlock Text="{x:Bind Title, Mode=OneWay}" TextWrapping="Wrap" FontSize="18" />
                <TextBlock Text="{x:Bind Description, Mode=OneWay}" TextWrapping="Wrap"
                           Style="{StaticResource CaptionTextBlockStyle}" />
            </StackPanel>
        </Grid>
    </Button>
</UserControl>
