<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:WPFGallery.Controls">
    <Style TargetType="controls:PageHeader">
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:PageHeader">
                    <StackPanel Spacing="8">
                        <ContentControl IsTabStop="True" TabIndex="0"
                                        AutomationProperties.Name="{TemplateBinding Title}"
                                        AutomationProperties.HeadingLevel="Level1">
                            <TextBlock AutomationProperties.AutomationId="PageTitle" Text="{TemplateBinding Title}" Style="{StaticResource TitleTextBlockStyle}" />
                        </ContentControl>
                        <TextBlock Text="{TemplateBinding Description}"
                                   Visibility="{Binding ShowDescription, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BooleanToVisibilityConverter}}"
                                   TextWrapping="Wrap"
                                   AutomationProperties.HeadingLevel="Level2" />
                    </StackPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
