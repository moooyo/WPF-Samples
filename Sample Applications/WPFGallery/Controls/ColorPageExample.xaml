<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:WPFGallery.Controls"
    xmlns:helpers="using:WPFGallery.Helpers">

    <Style TargetType="controls:ColorPageExample">
        <Setter Property="IsTabStop" Value="False" />


        <Setter Property="Background" Value="{ThemeResource SolidBackgroundFillColorBaseBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:ColorPageExample">
                    <Border BorderThickness="1" Margin="0,36,0,0" Padding="12" CornerRadius="8" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" Background="{TemplateBinding Background}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <TextBlock Margin="0,0,0,12" Style="{ThemeResource SubtitleTextBlockStyle}" Text="{TemplateBinding Title}" />
                            <TextBlock Style="{ThemeResource CaptionTextBlockStyle}" Text="{TemplateBinding Description}" Grid.Row="1"/>
                            <ContentPresenter
                                Grid.Row="2"
                                Margin="0,12,0,12"
                                HorizontalAlignment="Center"
                                Content="{TemplateBinding ExampleContent}" />
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
