<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:WPFGallery.Controls"
    xmlns:helpers="using:WPFGallery.Helpers">
    <helpers:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
    <Style x:Key="SelectionTextBox" TargetType="TextBox">
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="IsTabStop" Value="False" />
    </Style>
    <Style TargetType="controls:ControlExample">
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:ControlExample">
                    <StackPanel Spacing="8">
                        <TextBlock Text="{TemplateBinding HeaderText}" TextWrapping="Wrap"
                                   Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <Border Padding="16" CornerRadius="8" BorderThickness="1"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                            <ContentPresenter Content="{TemplateBinding ExampleContent}" />
                        </Border>
                        <Expander AutomationProperties.AutomationId="View source code" Header="Source code" HorizontalAlignment="Stretch"
                                  HorizontalContentAlignment="Stretch"
                                  AutomationProperties.Name="View source code">
                            <StackPanel Spacing="12">
                                <StackPanel Visibility="{Binding XamlCode, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource NullToVisibilityConverter}}">
                                    <Button AutomationProperties.AutomationId="Copy XAML Code" Content="Copy XAML" CommandParameter="XAML"
                                            Command="{Binding CopyCommand, RelativeSource={RelativeSource TemplatedParent}}"
                                            AutomationProperties.Name="Copy XAML Code" />
                                    <TextBox AutomationProperties.AutomationId="XAML Source Code" Text="{TemplateBinding XamlCode}" Style="{StaticResource SelectionTextBox}"
                                             AutomationProperties.Name="XAML Source Code" />
                                </StackPanel>
                                <StackPanel Visibility="{Binding CSharpCode, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource NullToVisibilityConverter}}">
                                    <Button AutomationProperties.AutomationId="Copy C# Code" Content="Copy C#" CommandParameter="C#"
                                            Command="{Binding CopyCommand, RelativeSource={RelativeSource TemplatedParent}}"
                                            AutomationProperties.Name="Copy C# Code" />
                                    <TextBox AutomationProperties.AutomationId="CSharp Source Code" Text="{TemplateBinding CSharpCode}" Style="{StaticResource SelectionTextBox}"
                                             AutomationProperties.Name="CSharp Source Code" />
                                </StackPanel>
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
