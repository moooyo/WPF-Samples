<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:WPFGallery.Controls">
    <Style TargetType="controls:ColorTile">
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:ColorTile">
                    <Border Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding TileRadius}" Padding="12">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="8">
                                <TextBlock Text="{TemplateBinding ColorName}" TextWrapping="Wrap"
                                           Foreground="{TemplateBinding Foreground}" FontWeight="SemiBold" />
                                <TextBlock Text="{TemplateBinding ColorExplanation}" TextWrapping="Wrap"
                                           Foreground="{TemplateBinding Foreground}" />
                                <TextBlock Text="{TemplateBinding ColorBrushName}" TextWrapping="Wrap"
                                           Foreground="{TemplateBinding Foreground}" FontSize="12" />
                                <TextBlock Text="{TemplateBinding CopyStatus}" AutomationProperties.LiveSetting="Polite"
                                           Foreground="{TemplateBinding Foreground}" FontSize="12" />
                            </StackPanel>
                            <Button AutomationProperties.AutomationId="{TemplateBinding ColorBrushName}" Grid.Column="1" Content="Copy" VerticalAlignment="Top"
                                    Command="{Binding CopyCommand, RelativeSource={RelativeSource TemplatedParent}}"
                                    AutomationProperties.Name="{TemplateBinding ColorBrushName}"
                                    ToolTipService.ToolTip="Copy brush name" />
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
