<Page
    x:Class="WPFGallery.Views.DatePickerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:WPFGallery.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:WPFGallery.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    Foreground="{ThemeResource TextFillColorPrimaryBrush}"
    mc:Ignorable="d">

    <Grid x:Name="ContentPagePane">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <controls:PageHeader Margin="0,0,0,32" Title="{x:Bind ViewModel.PageTitle, Mode=OneWay}" ShowDescription="False" />

        <ScrollViewer Grid.Row="1" Margin="0,0,0,24" Padding="0,0,24,0">
            <controls:ControlExample Margin="10" HeaderText="A basic DatePicker control."
                    XamlCode="&lt;CalendarDatePicker AutomationProperties.AutomationId=&quot;Pick a date&quot;&#10;    MinWidth=&quot;200&quot;&#10;    HorizontalAlignment=&quot;Left&quot;&#10;    AutomationProperties.Name=&quot;Pick a date&quot; /&gt;">

                <CalendarDatePicker AutomationProperties.AutomationId="Pick a date"
                    MinWidth="200"
                    HorizontalAlignment="Left"
                    AutomationProperties.Name="Pick a date" />
            </controls:ControlExample>
        </ScrollViewer>
    </Grid>
</Page>
