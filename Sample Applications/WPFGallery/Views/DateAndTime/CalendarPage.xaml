<Page
    x:Class="WPFGallery.Views.CalendarPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:WPFGallery.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:WPFGallery.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    Foreground="{ThemeResource TextFillColorPrimaryBrush}"
    mc:Ignorable="d">

    <Grid x:Name="ContentPagePane">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <controls:PageHeader Margin="0,0,0,32" Title="{x:Bind ViewModel.PageTitle, Mode=OneWay}" ShowDescription="False" />

        <ScrollViewer Grid.Row="1" Margin="0,0,0,24" Padding="0,0,24,0">
            <controls:ControlExample Margin="10" HeaderText="A basic Calendar control."
                    XamlCode="&lt;CalendarView AutomationProperties.AutomationId=&quot;Default&quot; HorizontalAlignment=&quot;Left&quot; AutomationProperties.Name=&quot;Default&quot; IsTabStop=&quot;False&quot;/&gt;">

                <CalendarView AutomationProperties.AutomationId="Default" HorizontalAlignment="Left" AutomationProperties.Name="Default" IsTabStop="False"/>
            </controls:ControlExample>
        </ScrollViewer>
    </Grid>
</Page>
