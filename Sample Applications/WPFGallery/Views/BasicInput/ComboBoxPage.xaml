<Page
    x:Class="WPFGallery.Views.ComboBoxPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:WPFGallery.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:WPFGallery.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    Foreground="{ThemeResource TextFillColorPrimaryBrush}"
    mc:Ignorable="d">

    <Grid x:Name="ContentPagePane">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <controls:PageHeader Margin="0,0,0,32" Title="{x:Bind ViewModel.PageTitle, Mode=OneWay}" ShowDescription="False" />

        <ScrollViewer Grid.Row="1" Margin="0,0,0,24" Padding="0,0,24,0">
            <StackPanel Margin="0,0,0,24">
                <controls:ControlExample
                    Margin="10"
                    HeaderText="A ComboBox with items defined inline."
                    XamlCode="&lt;ComboBox AutomationProperties.AutomationId=&quot;Sample defined inline&quot;&#10;    MinWidth=&quot;200&quot;&#10;    HorizontalAlignment=&quot;Left&quot;&#10;    AutomationProperties.Name=&quot;Sample defined inline&quot;&#10;    SelectedIndex=&quot;0&quot;&gt;&#10;    &lt;ComboBoxItem Content=&quot;Blue&quot; /&gt;&#10;    &lt;ComboBoxItem Content=&quot;Green&quot; /&gt;&#10;    &lt;ComboBoxItem Content=&quot;Red&quot; /&gt;&#10;    &lt;ComboBoxItem Content=&quot;Yellow&quot; /&gt;&#10;&lt;/ComboBox&gt;">
                    <ComboBox AutomationProperties.AutomationId="Sample defined inline"
                        MinWidth="200"
                        HorizontalAlignment="Left"
                        AutomationProperties.Name="Sample defined inline"
                        SelectedIndex="0">
                        <ComboBoxItem Content="Blue" />
                        <ComboBoxItem Content="Green" />
                        <ComboBoxItem Content="Red" />
                        <ComboBoxItem Content="Yellow" />
                    </ComboBox>
                </controls:ControlExample>

                <controls:ControlExample
                    Margin="10,32,10,10"
                    HeaderText="A ComboBox with ItemsSource set."
                    XamlCode="&lt;ComboBox AutomationProperties.AutomationId=&quot;Sample item source set&quot;&#10;    MinWidth=&quot;200&quot;&#10;    HorizontalAlignment=&quot;Left&quot;&#10;    AutomationProperties.Name=&quot;Sample item source set&quot;&#10;    ItemsSource=&quot;{x:Bind ViewModel.ComboBoxFontFamilies, Mode=OneWay}&quot;&#10;    SelectedIndex=&quot;0&quot;&gt;&#10;    &lt;ComboBox.ItemTemplate&gt;&#10;        &lt;DataTemplate&gt;&#10;            &lt;TextBlock FontFamily=&quot;{Binding}&quot; Text=&quot;{Binding}&quot; /&gt;&#10;        &lt;/DataTemplate&gt;&#10;    &lt;/ComboBox.ItemTemplate&gt;&#10;&lt;/ComboBox&gt;">
                    <ComboBox AutomationProperties.AutomationId="Sample item source set"
                        MinWidth="200"
                        HorizontalAlignment="Left"
                        AutomationProperties.Name="Sample item source set"
                        ItemsSource="{x:Bind ViewModel.ComboBoxFontFamilies, Mode=OneWay}"
                        SelectedIndex="0">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock FontFamily="{Binding}" Text="{Binding}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </controls:ControlExample>

                <controls:ControlExample
                    Margin="10,32,10,10"
                    HeaderText="An editable ComboBox."
                    XamlCode="&lt;ComboBox AutomationProperties.AutomationId=&quot;Editable&quot;&#10;    MinWidth=&quot;200&quot;&#10;    HorizontalAlignment=&quot;Left&quot;&#10;    AutomationProperties.Name=&quot;Editable&quot;&#10;    IsEditable=&quot;True&quot;&#10;    IsTabStop=&quot;False&quot;&#10;    ItemsSource=&quot;{x:Bind ViewModel.ComboBoxFontSizes, Mode=OneWay}&quot;&#10;    SelectedIndex=&quot;0&quot; /&gt;">
                    <ComboBox AutomationProperties.AutomationId="Editable"
                        MinWidth="200"
                        HorizontalAlignment="Left"
                        AutomationProperties.Name="Editable"
                        IsEditable="True"
                        IsTabStop="False"
                        ItemsSource="{x:Bind ViewModel.ComboBoxFontSizes, Mode=OneWay}"
                        SelectedIndex="0" />
                </controls:ControlExample>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
