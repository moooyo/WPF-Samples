<Page
    x:Class="WPFGallery.Views.SliderPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:WPFGallery.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:WPFGallery.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    Foreground="{ThemeResource TextFillColorPrimaryBrush}"
    mc:Ignorable="d">

    <Grid x:Name="ContentPagePane">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <controls:PageHeader Margin="0,0,0,32" Title="{x:Bind ViewModel.PageTitle, Mode=OneWay}" ShowDescription="False" />

        <ScrollViewer Grid.Row="1" Margin="0,0,0,24" Padding="0,0,24,0">
            <StackPanel Margin="0,0,0,24">
                <controls:ControlExample
                    Margin="10"
                    HeaderText="A simple slider."
                    XamlCode="&lt;Grid&gt;&#10;    &lt;Grid.ColumnDefinitions&gt;&#10;        &lt;ColumnDefinition Width=&quot;*&quot; /&gt;&#10;        &lt;ColumnDefinition Width=&quot;Auto&quot; /&gt;&#10;    &lt;/Grid.ColumnDefinitions&gt;&#10;    &lt;Slider AutomationProperties.AutomationId=&quot;Simple&quot;&#10;        Width=&quot;200&quot;&#10;        Margin=&quot;0&quot;&#10;        HorizontalAlignment=&quot;Left&quot;&#10;        VerticalAlignment=&quot;Center&quot;&#10;        AutomationProperties.Name=&quot;Simple&quot;&#10;        Maximum=&quot;100&quot;&#10;        Minimum=&quot;0&quot;&#10;        Value=&quot;{x:Bind ViewModel.SimpleSliderValue, Mode=TwoWay}&quot; /&gt;&#10;    &lt;Grid Grid.Column=&quot;1&quot;&gt;&#10;        &lt;StackPanel VerticalAlignment=&quot;Center&quot;&gt;&#10;            &lt;TextBlock Foreground=&quot;{ThemeResource TextFillColorPrimaryBrush}&quot; Text=&quot;Output:&quot; /&gt;&#10;            &lt;TextBlock Foreground=&quot;{ThemeResource TextFillColorPrimaryBrush}&quot; Text=&quot;{x:Bind ViewModel.SimpleSliderValue, Mode=OneWay}&quot; /&gt;&#10;        &lt;/StackPanel&gt;&#10;    &lt;/Grid&gt;&#10;&lt;/Grid&gt;">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Slider AutomationProperties.AutomationId="Simple"
                            Width="200"
                            Margin="0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="Simple"
                            Maximum="100"
                            Minimum="0"
                            Value="{x:Bind ViewModel.SimpleSliderValue, Mode=TwoWay}" />
                        <Grid Grid.Column="1">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Foreground="{ThemeResource TextFillColorPrimaryBrush}" Text="Output:" />
                                <TextBlock Foreground="{ThemeResource TextFillColorPrimaryBrush}" Text="{x:Bind ViewModel.SimpleSliderValue, Mode=OneWay}" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </controls:ControlExample>

                <controls:ControlExample
                    Margin="10,32,10,10"
                    HeaderText="A slider with steps and range specified."
                    XamlCode="&lt;Grid&gt;&#10;    &lt;Grid.ColumnDefinitions&gt;&#10;        &lt;ColumnDefinition Width=&quot;*&quot; /&gt;&#10;        &lt;ColumnDefinition Width=&quot;Auto&quot; /&gt;&#10;    &lt;/Grid.ColumnDefinitions&gt;&#10;    &lt;Slider AutomationProperties.AutomationId=&quot;Range and steps specified&quot;&#10;        Width=&quot;200&quot;&#10;        Margin=&quot;0&quot;&#10;        HorizontalAlignment=&quot;Left&quot;&#10;        VerticalAlignment=&quot;Center&quot;&#10;        AutomationProperties.Name=&quot;Range and steps specified&quot;&#10;        Maximum=&quot;1000&quot;&#10;        Minimum=&quot;500&quot;&#10;        TickFrequency=&quot;50&quot;&#10;        Value=&quot;{x:Bind ViewModel.RangeSliderValue, Mode=TwoWay}&quot; /&gt;&#10;    &lt;Grid Grid.Column=&quot;1&quot;&gt;&#10;        &lt;StackPanel VerticalAlignment=&quot;Center&quot;&gt;&#10;            &lt;TextBlock Foreground=&quot;{ThemeResource TextFillColorPrimaryBrush}&quot; Text=&quot;Output:&quot; /&gt;&#10;            &lt;TextBlock Foreground=&quot;{ThemeResource TextFillColorPrimaryBrush}&quot; Text=&quot;{x:Bind ViewModel.RangeSliderValue, Mode=OneWay}&quot; /&gt;&#10;        &lt;/StackPanel&gt;&#10;    &lt;/Grid&gt;&#10;&lt;/Grid&gt;">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Slider AutomationProperties.AutomationId="Range and steps specified"
                            Width="200"
                            Margin="0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="Range and steps specified"
                            Maximum="1000"
                            Minimum="500"
                            TickFrequency="50"
                            Value="{x:Bind ViewModel.RangeSliderValue, Mode=TwoWay}" />
                        <Grid Grid.Column="1">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Foreground="{ThemeResource TextFillColorPrimaryBrush}" Text="Output:" />
                                <TextBlock Foreground="{ThemeResource TextFillColorPrimaryBrush}" Text="{x:Bind ViewModel.RangeSliderValue, Mode=OneWay}" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </controls:ControlExample>

                <controls:ControlExample
                    Margin="10,32,10,10"
                    HeaderText="A slider with tick marks."
                    XamlCode="&lt;Grid&gt;&#10;    &lt;Grid.ColumnDefinitions&gt;&#10;        &lt;ColumnDefinition Width=&quot;*&quot; /&gt;&#10;        &lt;ColumnDefinition Width=&quot;Auto&quot; /&gt;&#10;    &lt;/Grid.ColumnDefinitions&gt;&#10;    &lt;Slider AutomationProperties.AutomationId=&quot;Tick marks&quot;&#10;        Width=&quot;200&quot;&#10;        Margin=&quot;0&quot;&#10;        HorizontalAlignment=&quot;Left&quot;&#10;        VerticalAlignment=&quot;Center&quot;&#10;        AutomationProperties.Name=&quot;Tick marks&quot;&#10;        Maximum=&quot;100&quot;&#10;        Minimum=&quot;0&quot;&#10;        TickFrequency=&quot;20&quot;&#10;        TickPlacement=&quot;Outside&quot;&#10;        Value=&quot;{x:Bind ViewModel.MarksSliderValue, Mode=TwoWay}&quot; /&gt;&#10;    &lt;Grid Grid.Column=&quot;1&quot;&gt;&#10;        &lt;StackPanel VerticalAlignment=&quot;Center&quot;&gt;&#10;            &lt;TextBlock Foreground=&quot;{ThemeResource TextFillColorPrimaryBrush}&quot; Text=&quot;Output:&quot; /&gt;&#10;            &lt;TextBlock Foreground=&quot;{ThemeResource TextFillColorPrimaryBrush}&quot; Text=&quot;{x:Bind ViewModel.MarksSliderValue, Mode=OneWay}&quot; /&gt;&#10;        &lt;/StackPanel&gt;&#10;    &lt;/Grid&gt;&#10;&lt;/Grid&gt;">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Slider AutomationProperties.AutomationId="Tick marks"
                            Width="200"
                            Margin="0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="Tick marks"
                            Maximum="100"
                            Minimum="0"
                            TickFrequency="20"
                            TickPlacement="Outside"
                            Value="{x:Bind ViewModel.MarksSliderValue, Mode=TwoWay}" />
                        <Grid Grid.Column="1">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Foreground="{ThemeResource TextFillColorPrimaryBrush}" Text="Output:" />
                                <TextBlock Foreground="{ThemeResource TextFillColorPrimaryBrush}" Text="{x:Bind ViewModel.MarksSliderValue, Mode=OneWay}" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </controls:ControlExample>

                <controls:ControlExample
                    Margin="10,32,10,10"
                    HeaderText="A vertical slider with range and tick marks specified."
                    XamlCode="&lt;Grid&gt;&#10;    &lt;Grid.ColumnDefinitions&gt;&#10;        &lt;ColumnDefinition Width=&quot;*&quot; /&gt;&#10;        &lt;ColumnDefinition Width=&quot;Auto&quot; /&gt;&#10;    &lt;/Grid.ColumnDefinitions&gt;&#10;    &lt;Slider AutomationProperties.AutomationId=&quot;Vertical&quot;&#10;        Width=&quot;200&quot;&#10;        Margin=&quot;0&quot;&#10;        HorizontalAlignment=&quot;Left&quot;&#10;        VerticalAlignment=&quot;Center&quot;&#10;        AutomationProperties.Name=&quot;Vertical&quot;&#10;        Maximum=&quot;100&quot;&#10;        Minimum=&quot;0&quot;&#10;        Orientation=&quot;Vertical&quot;&#10;        TickFrequency=&quot;20&quot;&#10;        TickPlacement=&quot;Outside&quot;&#10;        Value=&quot;{x:Bind ViewModel.VerticalSliderValue, Mode=TwoWay}&quot; /&gt;&#10;    &lt;Grid Grid.Column=&quot;1&quot;&gt;&#10;        &lt;StackPanel VerticalAlignment=&quot;Center&quot;&gt;&#10;            &lt;TextBlock Foreground=&quot;{ThemeResource TextFillColorPrimaryBrush}&quot; Text=&quot;Output:&quot; /&gt;&#10;            &lt;TextBlock Foreground=&quot;{ThemeResource TextFillColorPrimaryBrush}&quot; Text=&quot;{x:Bind ViewModel.VerticalSliderValue, Mode=OneWay}&quot; /&gt;&#10;        &lt;/StackPanel&gt;&#10;    &lt;/Grid&gt;&#10;&lt;/Grid&gt;">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Slider AutomationProperties.AutomationId="Vertical"
                            Width="200"
                            Margin="0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="Vertical"
                            Maximum="100"
                            Minimum="0"
                            Orientation="Vertical"
                            TickFrequency="20"
                            TickPlacement="Outside"
                            Value="{x:Bind ViewModel.VerticalSliderValue, Mode=TwoWay}" />
                        <Grid Grid.Column="1">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Foreground="{ThemeResource TextFillColorPrimaryBrush}" Text="Output:" />
                                <TextBlock Foreground="{ThemeResource TextFillColorPrimaryBrush}" Text="{x:Bind ViewModel.VerticalSliderValue, Mode=OneWay}" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </controls:ControlExample>
            </StackPanel>

        </ScrollViewer>
    </Grid>
</Page>
