<Page
    x:Class="WPFGallery.Views.RadioButtonPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:WPFGallery.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:WPFGallery.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    Foreground="{ThemeResource TextFillColorPrimaryBrush}"
    mc:Ignorable="d">

    <Grid x:Name="ContentPagePane">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <controls:PageHeader Margin="0,0,0,32" Title="{x:Bind ViewModel.PageTitle, Mode=OneWay}" ShowDescription="False" />

        <ScrollViewer Grid.Row="1" Margin="0,0,0,24" Padding="0,0,24,0">
            <StackPanel Margin="0,0,0,24">
                <controls:ControlExample
                    Margin="10"
                    HeaderText="Standard RadioButton."
                    XamlCode="&lt;Grid&gt;&#10;    &lt;Grid.ColumnDefinitions&gt;&#10;        &lt;ColumnDefinition Width=&quot;*&quot; /&gt;&#10;        &lt;ColumnDefinition Width=&quot;Auto&quot; /&gt;&#10;    &lt;/Grid.ColumnDefinitions&gt;&#10;    &lt;StackPanel Grid.Column=&quot;0&quot;&gt;&#10;        &lt;RadioButton AutomationProperties.AutomationId=&quot;Default Radio Option 1&quot;&#10;            AutomationProperties.Name=&quot;Default Radio Option 1&quot;&#10;            Content=&quot;Option 1&quot;&#10;            GroupName=&quot;radio_group_one&quot;&#10;            IsChecked=&quot;True&quot;&#10;            GotFocus=&quot;RadioButton_GotKeyboardFocus&quot;&#10;            IsEnabled=&quot;{x:Bind ViewModel.IsRadioButtonEnabled, Mode=OneWay}&quot; /&gt;&#10;        &lt;RadioButton AutomationProperties.AutomationId=&quot;Default Radio Option 2&quot;&#10;            AutomationProperties.Name=&quot;Default Radio Option 2&quot;&#10;            Content=&quot;Option 2&quot;&#10;            GroupName=&quot;radio_group_one&quot;&#10;            GotFocus=&quot;RadioButton_GotKeyboardFocus&quot;&#10;            IsEnabled=&quot;{x:Bind ViewModel.IsRadioButtonEnabled, Mode=OneWay}&quot; /&gt;&#10;        &lt;RadioButton AutomationProperties.AutomationId=&quot;Default Radio Option 3&quot;&#10;            AutomationProperties.Name=&quot;Default Radio Option 3&quot;&#10;            Content=&quot;Option 3&quot;&#10;            GroupName=&quot;radio_group_one&quot;&#10;            GotFocus=&quot;RadioButton_GotKeyboardFocus&quot;&#10;            IsEnabled=&quot;{x:Bind ViewModel.IsRadioButtonEnabled, Mode=OneWay}&quot; /&gt;&#10;    &lt;/StackPanel&gt;&#10;    &lt;CheckBox AutomationProperties.AutomationId=&quot;RadioButtonCheckboxCheckedCommand&quot;&#10;        Grid.Column=&quot;1&quot;&#10;        Command=&quot;{x:Bind ViewModel.RadioButtonCheckboxCheckedCommand, Mode=OneWay}&quot;&#10;        CommandParameter=&quot;{Binding RelativeSource={RelativeSource Self}, Mode=OneWay}&quot;&#10;        Content=&quot;Disable RadioButton's&quot; /&gt;&#10;&lt;/Grid&gt;">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <RadioButton AutomationProperties.AutomationId="Default Radio Option 1"
                                AutomationProperties.Name="Default Radio Option 1"
                                Content="Option 1"
                                GroupName="radio_group_one"
                                IsChecked="True"
                                GotFocus="RadioButton_GotKeyboardFocus"
                                IsEnabled="{x:Bind ViewModel.IsRadioButtonEnabled, Mode=OneWay}" />
                            <RadioButton AutomationProperties.AutomationId="Default Radio Option 2"
                                AutomationProperties.Name="Default Radio Option 2"
                                Content="Option 2"
                                GroupName="radio_group_one"
                                GotFocus="RadioButton_GotKeyboardFocus"
                                IsEnabled="{x:Bind ViewModel.IsRadioButtonEnabled, Mode=OneWay}" />
                            <RadioButton AutomationProperties.AutomationId="Default Radio Option 3"
                                AutomationProperties.Name="Default Radio Option 3"
                                Content="Option 3"
                                GroupName="radio_group_one"
                                GotFocus="RadioButton_GotKeyboardFocus"
                                IsEnabled="{x:Bind ViewModel.IsRadioButtonEnabled, Mode=OneWay}" />
                        </StackPanel>
                        <CheckBox AutomationProperties.AutomationId="RadioButtonCheckboxCheckedCommand"
                            Grid.Column="1"
                            Command="{x:Bind ViewModel.RadioButtonCheckboxCheckedCommand, Mode=OneWay}"
                            CommandParameter="{Binding RelativeSource={RelativeSource Self}, Mode=OneWay}"
                            Content="Disable RadioButton's" />
                    </Grid>
                </controls:ControlExample>

                <controls:ControlExample
                    Margin="10,36,10,10"
                    HeaderText="RadioButton with right to left flow direction."
                    XamlCode="&lt;StackPanel Grid.Column=&quot;0&quot;&gt;&#10;    &lt;RadioButton AutomationProperties.AutomationId=&quot;Left Flow Radio Option 1&quot;&#10;        AutomationProperties.Name=&quot;Left Flow Radio Option 1&quot;&#10;        Content=&quot;Option 1&quot;&#10;        FlowDirection=&quot;RightToLeft&quot;&#10;        GroupName=&quot;radio_group_two&quot;&#10;        GotFocus=&quot;RadioButton_GotKeyboardFocus&quot;&#10;        IsChecked=&quot;True&quot; /&gt;&#10;    &lt;RadioButton AutomationProperties.AutomationId=&quot;Left Flow Radio Option 2&quot;&#10;        AutomationProperties.Name=&quot;Left Flow Radio Option 2&quot;&#10;        Content=&quot;Option 2&quot;&#10;        FlowDirection=&quot;RightToLeft&quot;&#10;        GotFocus=&quot;RadioButton_GotKeyboardFocus&quot;&#10;        GroupName=&quot;radio_group_two&quot; /&gt;&#10;    &lt;RadioButton AutomationProperties.AutomationId=&quot;Left Flow Radio Option 3&quot;&#10;        AutomationProperties.Name=&quot;Left Flow Radio Option 3&quot;&#10;        Content=&quot;Option 3&quot;&#10;        FlowDirection=&quot;RightToLeft&quot;&#10;        GotFocus=&quot;RadioButton_GotKeyboardFocus&quot;&#10;        GroupName=&quot;radio_group_two&quot; /&gt;&#10;&lt;/StackPanel&gt;">
                    <StackPanel Grid.Column="0">
                        <RadioButton AutomationProperties.AutomationId="Left Flow Radio Option 1"
                            AutomationProperties.Name="Left Flow Radio Option 1"
                            Content="Option 1"
                            FlowDirection="RightToLeft"
                            GroupName="radio_group_two"
                            GotFocus="RadioButton_GotKeyboardFocus"
                            IsChecked="True" />
                        <RadioButton AutomationProperties.AutomationId="Left Flow Radio Option 2"
                            AutomationProperties.Name="Left Flow Radio Option 2"
                            Content="Option 2"
                            FlowDirection="RightToLeft"
                            GotFocus="RadioButton_GotKeyboardFocus"
                            GroupName="radio_group_two" />
                        <RadioButton AutomationProperties.AutomationId="Left Flow Radio Option 3"
                            AutomationProperties.Name="Left Flow Radio Option 3"
                            Content="Option 3"
                            FlowDirection="RightToLeft"
                            GotFocus="RadioButton_GotKeyboardFocus"
                            GroupName="radio_group_two" />
                    </StackPanel>
                </controls:ControlExample>
            </StackPanel>

        </ScrollViewer>
    </Grid>
</Page>
