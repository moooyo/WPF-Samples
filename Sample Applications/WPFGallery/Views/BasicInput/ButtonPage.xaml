<Page
    x:Class="WPFGallery.Views.ButtonPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:WPFGallery.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:WPFGallery.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    Foreground="{ThemeResource TextFillColorPrimaryBrush}"
    mc:Ignorable="d">

    <Grid x:Name="ContentPagePane">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <controls:PageHeader Margin="0,0,0,32" Title="{x:Bind ViewModel.PageTitle, Mode=OneWay}" ShowDescription="False" />

        <ScrollViewer Grid.Row="1" Margin="0,0,0,24" Padding="0,0,24,0">
            <StackPanel>
                <controls:ControlExample
                    Margin="10"
                    HeaderText="Simple Button"
                    AutomationProperties.Name="View Source Code for the simple example"
                    XamlCode="&lt;Grid&gt;&#10;    &lt;Grid.ColumnDefinitions&gt;&#10;        &lt;ColumnDefinition Width=&quot;*&quot; /&gt;&#10;        &lt;ColumnDefinition Width=&quot;Auto&quot; /&gt;&#10;    &lt;/Grid.ColumnDefinitions&gt;&#10;    &lt;Button AutomationProperties.AutomationId=&quot;Standard WPF&quot;&#10;        Grid.Column=&quot;0&quot;&#10;        AutomationProperties.Name=&quot;Standard WPF&quot;&#10;        Content=&quot;Standard WPF button&quot;&#10;        IsEnabled=&quot;{x:Bind ViewModel.IsSimpleButtonEnabled, Mode=OneWay}&quot; /&gt;&#10;    &lt;CheckBox AutomationProperties.AutomationId=&quot;SimpleButtonCheckboxCheckedCommand&quot;&#10;        Grid.Column=&quot;1&quot;&#10;        Command=&quot;{x:Bind ViewModel.SimpleButtonCheckboxCheckedCommand, Mode=OneWay}&quot;&#10;        CommandParameter=&quot;{Binding RelativeSource={RelativeSource Self}, Mode=OneWay}&quot;&#10;        Content=&quot;Disable button&quot; /&gt;&#10;&lt;/Grid&gt;">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button AutomationProperties.AutomationId="Standard WPF"
                            Grid.Column="0"
                            AutomationProperties.Name="Standard WPF"
                            Content="Standard WPF button"
                            IsEnabled="{x:Bind ViewModel.IsSimpleButtonEnabled, Mode=OneWay}" />
                        <CheckBox AutomationProperties.AutomationId="SimpleButtonCheckboxCheckedCommand"
                            Grid.Column="1"
                            Command="{x:Bind ViewModel.SimpleButtonCheckboxCheckedCommand, Mode=OneWay}"
                            CommandParameter="{Binding RelativeSource={RelativeSource Self}, Mode=OneWay}"
                            Content="Disable button" />
                    </Grid>
                </controls:ControlExample>



                <controls:ControlExample
                    Margin="10,32,10,10"
                    HeaderText="WPF Accent Button"
                    AutomationProperties.Name="View Source Code for the WPF accent example"
                    XamlCode="&lt;Button AutomationProperties.AutomationId=&quot;WPF Accent&quot; AutomationProperties.Name=&quot;WPF Accent&quot; Style=&quot;{ThemeResource AccentButtonStyle}&quot;&gt;&#10;    &lt;StackPanel Orientation=&quot;Horizontal&quot;&gt;&#10;        &#10;        &lt;TextBlock Text=&quot;WPF Accent Button&quot; /&gt;&#10;    &lt;/StackPanel&gt;&#10;&lt;/Button&gt;">
                    <Button AutomationProperties.AutomationId="WPF Accent" AutomationProperties.Name="WPF Accent" Style="{ThemeResource AccentButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <!--<SymbolIcon Symbol="Fluent24" />-->
                            <TextBlock Text="WPF Accent Button" />
                        </StackPanel>
                    </Button>
                </controls:ControlExample>



            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
