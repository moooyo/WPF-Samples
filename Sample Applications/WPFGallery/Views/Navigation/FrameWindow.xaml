<winuiex:WindowEx x:Class="WPFGallery.Views.FrameWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:winuiex="using:WinUIEx"
    Title="FrameWindow" Height="450" Width="800">
    <Grid Padding="24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" Spacing="8">
            <Button AutomationProperties.AutomationId="Back_Click" Content="Back" Click="Back_Click" />
            <Button AutomationProperties.AutomationId="Forward_Click" Content="Forward" Click="Forward_Click" />
        </StackPanel>
        <Frame x:Name="SampleFrame" Grid.Row="1" />
    </Grid>
</winuiex:WindowEx>
