<Page x:Class="WPFGallery.Views.MenuPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:WPFGallery.Controls">
    <Grid RowSpacing="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <controls:PageHeader Title="{x:Bind ViewModel.PageTitle}" ShowDescription="False" />
        <ScrollViewer Grid.Row="1">
            <controls:ControlExample HeaderText="Standard MenuBar."
                    XamlCode="&lt;StackPanel Spacing=&quot;12&quot;&gt;&#10;    &lt;TextBlock x:Name=&quot;StatusMenuItem&quot; AutomationProperties.LiveSetting=&quot;Polite&quot; /&gt;&#10;    &lt;MenuBar&gt;&#10;        &lt;MenuBarItem Title=&quot;File&quot;&gt;&#10;            &lt;MenuFlyoutItem AutomationProperties.AutomationId=&quot;MenuItem_Click&quot; Text=&quot;New&quot; Click=&quot;MenuItem_Click&quot; /&gt;&#10;            &lt;MenuFlyoutItem AutomationProperties.AutomationId=&quot;MenuItem_Click&quot; Text=&quot;New window&quot; Click=&quot;MenuItem_Click&quot; /&gt;&#10;            &lt;MenuFlyoutItem AutomationProperties.AutomationId=&quot;MenuItem_Click&quot; Text=&quot;Open&quot; Click=&quot;MenuItem_Click&quot; /&gt;&#10;            &lt;MenuFlyoutItem AutomationProperties.AutomationId=&quot;MenuItem_Click&quot; Text=&quot;Save&quot; Click=&quot;MenuItem_Click&quot; /&gt;&#10;            &lt;MenuFlyoutItem AutomationProperties.AutomationId=&quot;MenuItem_Click&quot; Text=&quot;Save As&quot; Click=&quot;MenuItem_Click&quot; /&gt;&#10;            &lt;MenuFlyoutSeparator /&gt;&#10;            &lt;MenuFlyoutItem AutomationProperties.AutomationId=&quot;MenuItem_Click&quot; Text=&quot;Exit&quot; Click=&quot;MenuItem_Click&quot; /&gt;&#10;        &lt;/MenuBarItem&gt;&#10;        &lt;MenuBarItem Title=&quot;Edit&quot;&gt;&#10;            &lt;MenuFlyoutItem AutomationProperties.AutomationId=&quot;MenuItem_Click&quot; Text=&quot;Undo&quot; Click=&quot;MenuItem_Click&quot; /&gt;&#10;            &lt;MenuFlyoutSeparator /&gt;&#10;            &lt;MenuFlyoutItem AutomationProperties.AutomationId=&quot;MenuItem_Click&quot; Text=&quot;Cut&quot; Click=&quot;MenuItem_Click&quot; /&gt;&#10;            &lt;MenuFlyoutItem AutomationProperties.AutomationId=&quot;MenuItem_Click&quot; Text=&quot;Copy&quot; Click=&quot;MenuItem_Click&quot; /&gt;&#10;            &lt;MenuFlyoutItem AutomationProperties.AutomationId=&quot;MenuItem_Click&quot; Text=&quot;Paste&quot; Click=&quot;MenuItem_Click&quot; /&gt;&#10;            &lt;MenuFlyoutItem Text=&quot;Unavailable&quot; IsEnabled=&quot;False&quot; /&gt;&#10;            &lt;MenuFlyoutSeparator /&gt;&#10;            &lt;MenuFlyoutItem AutomationProperties.AutomationId=&quot;MenuItem_Click&quot; Text=&quot;Search with browser&quot; Click=&quot;MenuItem_Click&quot; /&gt;&#10;            &lt;MenuFlyoutItem AutomationProperties.AutomationId=&quot;MenuItem_Click&quot; Text=&quot;Find&quot; Click=&quot;MenuItem_Click&quot; /&gt;&#10;            &lt;MenuFlyoutItem AutomationProperties.AutomationId=&quot;MenuItem_Click&quot; Text=&quot;Find next&quot; Click=&quot;MenuItem_Click&quot; /&gt;&#10;            &lt;MenuFlyoutSeparator /&gt;&#10;            &lt;MenuFlyoutItem AutomationProperties.AutomationId=&quot;MenuItem_Click&quot; Text=&quot;Select All&quot; Click=&quot;MenuItem_Click&quot; /&gt;&#10;        &lt;/MenuBarItem&gt;&#10;        &lt;MenuBarItem Title=&quot;Format&quot;&gt;&#10;            &lt;MenuFlyoutItem AutomationProperties.AutomationId=&quot;MenuItem_Click&quot; Text=&quot;Bold&quot; Click=&quot;MenuItem_Click&quot; /&gt;&#10;            &lt;MenuFlyoutItem AutomationProperties.AutomationId=&quot;MenuItem_Click&quot; Text=&quot;Italic&quot; Click=&quot;MenuItem_Click&quot; /&gt;&#10;            &lt;MenuFlyoutItem AutomationProperties.AutomationId=&quot;MenuItem_Click&quot; Text=&quot;Underlined&quot; Click=&quot;MenuItem_Click&quot; /&gt;&#10;        &lt;/MenuBarItem&gt;&#10;    &lt;/MenuBar&gt;&#10;&lt;/StackPanel&gt;"
                    CSharpCode="private void MenuItem_Click(object sender, RoutedEventArgs e)&#10;        {&#10;            if (sender is MenuFlyoutItem menuItem)&#10;            {&#10;                StatusMenuItem.Text = $&quot;You pressed {menuItem.Text}&quot;;&#10;            }&#10;        }">
                <StackPanel Spacing="12">
                    <TextBlock x:Name="StatusMenuItem" AutomationProperties.LiveSetting="Polite" />
                    <MenuBar>
                        <MenuBarItem Title="File">
                            <MenuFlyoutItem AutomationProperties.AutomationId="MenuItem_Click" Text="New" Click="MenuItem_Click" />
                            <MenuFlyoutItem AutomationProperties.AutomationId="MenuItem_Click" Text="New window" Click="MenuItem_Click" />
                            <MenuFlyoutItem AutomationProperties.AutomationId="MenuItem_Click" Text="Open" Click="MenuItem_Click" />
                            <MenuFlyoutItem AutomationProperties.AutomationId="MenuItem_Click" Text="Save" Click="MenuItem_Click" />
                            <MenuFlyoutItem AutomationProperties.AutomationId="MenuItem_Click" Text="Save As" Click="MenuItem_Click" />
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem AutomationProperties.AutomationId="MenuItem_Click" Text="Exit" Click="MenuItem_Click" />
                        </MenuBarItem>
                        <MenuBarItem Title="Edit">
                            <MenuFlyoutItem AutomationProperties.AutomationId="MenuItem_Click" Text="Undo" Click="MenuItem_Click" />
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem AutomationProperties.AutomationId="MenuItem_Click" Text="Cut" Click="MenuItem_Click" />
                            <MenuFlyoutItem AutomationProperties.AutomationId="MenuItem_Click" Text="Copy" Click="MenuItem_Click" />
                            <MenuFlyoutItem AutomationProperties.AutomationId="MenuItem_Click" Text="Paste" Click="MenuItem_Click" />
                            <MenuFlyoutItem Text="Unavailable" IsEnabled="False" />
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem AutomationProperties.AutomationId="MenuItem_Click" Text="Search with browser" Click="MenuItem_Click" />
                            <MenuFlyoutItem AutomationProperties.AutomationId="MenuItem_Click" Text="Find" Click="MenuItem_Click" />
                            <MenuFlyoutItem AutomationProperties.AutomationId="MenuItem_Click" Text="Find next" Click="MenuItem_Click" />
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem AutomationProperties.AutomationId="MenuItem_Click" Text="Select All" Click="MenuItem_Click" />
                        </MenuBarItem>
                        <MenuBarItem Title="Format">
                            <MenuFlyoutItem AutomationProperties.AutomationId="MenuItem_Click" Text="Bold" Click="MenuItem_Click" />
                            <MenuFlyoutItem AutomationProperties.AutomationId="MenuItem_Click" Text="Italic" Click="MenuItem_Click" />
                            <MenuFlyoutItem AutomationProperties.AutomationId="MenuItem_Click" Text="Underlined" Click="MenuItem_Click" />
                        </MenuBarItem>
                    </MenuBar>
                </StackPanel>
            </controls:ControlExample>
        </ScrollViewer>
    </Grid>
</Page>
