<Page
    x:Class="WPFGallery.Views.TabControlPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:WPFGallery.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:WPFGallery.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    Foreground="{ThemeResource TextFillColorPrimaryBrush}"
    mc:Ignorable="d">

    <Grid x:Name="ContentPagePane">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <controls:PageHeader Margin="0,0,0,32" Title="{x:Bind ViewModel.PageTitle, Mode=OneWay}" ShowDescription="False" />

        <ScrollViewer Grid.Row="1" Margin="0,0,0,24" Padding="0,0,24,0">
            <Grid Margin="0,0,0,24">
                <controls:ControlExample
                    Margin="10"
                    HeaderText="Standard TabControl."
                    XamlCode="&lt;TabView Margin=&quot;0,8,0,0&quot; IsAddTabButtonVisible=&quot;False&quot; SelectedIndex=&quot;1&quot;&gt;&lt;TabView.TabItems&gt;&#10;    &lt;TabViewItem IsClosable=&quot;False&quot; AutomationProperties.Name=&quot;Hello Tab&quot;&gt;&#10;        &lt;TabViewItem.Header&gt;&#10;            &lt;StackPanel Orientation=&quot;Horizontal&quot;&gt;&#10;                &#10;                &lt;TextBlock Text=&quot;Hello&quot; /&gt;&#10;            &lt;/StackPanel&gt;&#10;        &lt;/TabViewItem.Header&gt;&#10;        &lt;Grid&gt;&#10;            &lt;TextBlock Margin=&quot;12&quot; Text=&quot;World&quot; /&gt;&#10;        &lt;/Grid&gt;&#10;    &lt;/TabViewItem&gt;&#10;    &lt;TabViewItem IsClosable=&quot;False&quot; AutomationProperties.Name=&quot;The cake Tab&quot;&gt;&#10;        &lt;TabViewItem.Header&gt;&#10;            &lt;StackPanel Orientation=&quot;Horizontal&quot;&gt;&#10;                &#10;                &lt;TextBlock Text=&quot;The cake&quot; /&gt;&#10;            &lt;/StackPanel&gt;&#10;        &lt;/TabViewItem.Header&gt;&#10;        &lt;Grid&gt;&#10;            &lt;TextBlock Margin=&quot;12&quot; Text=&quot;Is a lie.&quot; /&gt;&#10;        &lt;/Grid&gt;&#10;    &lt;/TabViewItem&gt;&#10;&lt;/TabView.TabItems&gt;&lt;/TabView&gt;">
                    <TabView Margin="0,8,0,0" IsAddTabButtonVisible="False" SelectedIndex="1"><TabView.TabItems>
                        <TabViewItem IsClosable="False" AutomationProperties.Name="Hello Tab">
                            <TabViewItem.Header>
                                <StackPanel Orientation="Horizontal">
                                    <!--<SymbolIcon Margin="0,0,6,0" Symbol="XboxConsole24" />-->
                                    <TextBlock Text="Hello" />
                                </StackPanel>
                            </TabViewItem.Header>
                            <Grid>
                                <TextBlock Margin="12" Text="World" />
                            </Grid>
                        </TabViewItem>
                        <TabViewItem IsClosable="False" AutomationProperties.Name="The cake Tab">
                            <TabViewItem.Header>
                                <StackPanel Orientation="Horizontal">
                                    <!--<SymbolIcon Margin="0,0,6,0" Symbol="StoreMicrosoft16" />-->
                                    <TextBlock Text="The cake" />
                                </StackPanel>
                            </TabViewItem.Header>
                            <Grid>
                                <TextBlock Margin="12" Text="Is a lie." />
                            </Grid>
                        </TabViewItem>
                    </TabView.TabItems></TabView>
                </controls:ControlExample>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>
