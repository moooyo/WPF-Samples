<Page x:Class="WPFGallery.Views.DataGridPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:WPFGallery.Controls"
    xmlns:models="using:WPFGallery.Models">
    <Grid RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <controls:PageHeader Title="{x:Bind ViewModel.PageTitle}" ShowDescription="False" />
        <ScrollViewer Grid.Row="1" Margin="0,0,0,24">
            <controls:ControlExample HeaderText="Editable tabular data using ListView and typed bindings."
                    XamlCode="&lt;ListView AutomationProperties.AutomationId=&quot;SampleDataGrid&quot; x:Name=&quot;SampleDataGrid&quot; Height=&quot;400&quot;&#10;          ScrollViewer.HorizontalScrollMode=&quot;Enabled&quot; ScrollViewer.HorizontalScrollBarVisibility=&quot;Auto&quot;&#10;          ItemsSource=&quot;{x:Bind ViewModel.ProductsCollection, Mode=OneWay}&quot;&#10;          AutomationProperties.Name=&quot;Sample Data Grid&quot; SelectionMode=&quot;Single&quot;&gt;&#10;    &lt;ListView.Header&gt;&#10;        &lt;Grid ColumnSpacing=&quot;8&quot; Padding=&quot;12,0&quot; MinWidth=&quot;844&quot;&gt;&#10;            &lt;Grid.ColumnDefinitions&gt;&#10;                &lt;ColumnDefinition Width=&quot;70&quot; /&gt;&#10;                &lt;ColumnDefinition Width=&quot;90&quot; /&gt;&#10;                &lt;ColumnDefinition Width=&quot;240&quot; /&gt;&#10;                &lt;ColumnDefinition Width=&quot;120&quot; /&gt;&#10;                &lt;ColumnDefinition Width=&quot;130&quot; /&gt;&#10;                &lt;ColumnDefinition Width=&quot;130&quot; /&gt;&#10;            &lt;/Grid.ColumnDefinitions&gt;&#10;            &lt;Button AutomationProperties.AutomationId=&quot;SortProductId&quot; Content=&quot;ID&quot; Tag=&quot;ProductId&quot; Click=&quot;Sort_Click&quot; /&gt;&#10;            &lt;Button AutomationProperties.AutomationId=&quot;SortProductCode&quot; Grid.Column=&quot;1&quot; Content=&quot;Code&quot; Tag=&quot;ProductCode&quot; Click=&quot;Sort_Click&quot; /&gt;&#10;            &lt;Button AutomationProperties.AutomationId=&quot;SortProductName&quot; Grid.Column=&quot;2&quot; Content=&quot;Product&quot; Tag=&quot;ProductName&quot; Click=&quot;Sort_Click&quot; /&gt;&#10;            &lt;Button AutomationProperties.AutomationId=&quot;SortQuantity&quot; Grid.Column=&quot;3&quot; Content=&quot;Quantity&quot; Tag=&quot;QuantityPerUnit&quot; Click=&quot;Sort_Click&quot; /&gt;&#10;            &lt;Button AutomationProperties.AutomationId=&quot;SortPrice&quot; Grid.Column=&quot;4&quot; Content=&quot;Price&quot; Tag=&quot;UnitPrice&quot; Click=&quot;Sort_Click&quot; /&gt;&#10;            &lt;Button AutomationProperties.AutomationId=&quot;SortStock&quot; Grid.Column=&quot;5&quot; Content=&quot;Stock&quot; Tag=&quot;UnitsInStock&quot; Click=&quot;Sort_Click&quot; /&gt;&#10;        &lt;/Grid&gt;&#10;    &lt;/ListView.Header&gt;&#10;    &lt;ListView.ItemTemplate&gt;&#10;        &lt;DataTemplate x:DataType=&quot;models:Product&quot;&gt;&#10;            &lt;Grid ColumnSpacing=&quot;8&quot; MinWidth=&quot;820&quot; AutomationProperties.Name=&quot;{x:Bind ProductName}&quot;&gt;&#10;                &lt;Grid.RowDefinitions&gt;&#10;                    &lt;RowDefinition Height=&quot;Auto&quot; /&gt;&#10;                    &lt;RowDefinition Height=&quot;Auto&quot; /&gt;&#10;                &lt;/Grid.RowDefinitions&gt;&#10;                &lt;Grid.ColumnDefinitions&gt;&#10;                    &lt;ColumnDefinition Width=&quot;70&quot; /&gt;&#10;                    &lt;ColumnDefinition Width=&quot;90&quot; /&gt;&#10;                    &lt;ColumnDefinition Width=&quot;240&quot; /&gt;&#10;                    &lt;ColumnDefinition Width=&quot;120&quot; /&gt;&#10;                    &lt;ColumnDefinition Width=&quot;130&quot; /&gt;&#10;                    &lt;ColumnDefinition Width=&quot;130&quot; /&gt;&#10;                &lt;/Grid.ColumnDefinitions&gt;&#10;                &lt;TextBox AutomationProperties.AutomationId=&quot;{x:Bind AutomationId('ProductID')}&quot; Text=&quot;{x:Bind ProductIdInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}&quot; AutomationProperties.Name=&quot;Product ID&quot; /&gt;&#10;                &lt;TextBox AutomationProperties.AutomationId=&quot;{x:Bind AutomationId('ProductCode')}&quot; Grid.Column=&quot;1&quot; Text=&quot;{x:Bind ProductCodeInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}&quot; AutomationProperties.Name=&quot;Product Code&quot; /&gt;&#10;                &lt;TextBox AutomationProperties.AutomationId=&quot;{x:Bind AutomationId('ProductName')}&quot; Grid.Column=&quot;2&quot; Text=&quot;{x:Bind ProductName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}&quot; AutomationProperties.Name=&quot;Product Name&quot; /&gt;&#10;                &lt;TextBox AutomationProperties.AutomationId=&quot;{x:Bind AutomationId('QuantityPerUnit')}&quot; Grid.Column=&quot;3&quot; Text=&quot;{x:Bind QuantityPerUnit, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}&quot; AutomationProperties.Name=&quot;Quantity Per Unit&quot; /&gt;&#10;                &lt;NumberBox AutomationProperties.AutomationId=&quot;{x:Bind AutomationId('UnitPrice')}&quot; Grid.Column=&quot;4&quot; Value=&quot;{x:Bind UnitPriceInput, Mode=TwoWay}&quot; AutomationProperties.Name=&quot;Unit Price&quot; /&gt;&#10;                &lt;TextBox AutomationProperties.AutomationId=&quot;{x:Bind AutomationId('UnitsInStock')}&quot; Grid.Column=&quot;5&quot; Text=&quot;{x:Bind UnitsInStockInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}&quot; AutomationProperties.Name=&quot;Units In Stock&quot; /&gt;&#10;                &lt;TextBlock Grid.Row=&quot;1&quot; Grid.ColumnSpan=&quot;6&quot; Text=&quot;{x:Bind ValidationError, Mode=OneWay}&quot;&#10;                           AutomationProperties.AutomationId=&quot;{x:Bind AutomationId('ProductValidation')}&quot;&#10;                           Foreground=&quot;{ThemeResource SystemFillColorCriticalBrush}&quot;&#10;                           AutomationProperties.LiveSetting=&quot;Polite&quot; TextWrapping=&quot;Wrap&quot; /&gt;&#10;            &lt;/Grid&gt;&#10;        &lt;/DataTemplate&gt;&#10;    &lt;/ListView.ItemTemplate&gt;&#10;&lt;/ListView&gt;">
                <ListView AutomationProperties.AutomationId="SampleDataGrid" x:Name="SampleDataGrid" Height="400"
                          ScrollViewer.HorizontalScrollMode="Enabled" ScrollViewer.HorizontalScrollBarVisibility="Auto"
                          ItemsSource="{x:Bind ViewModel.ProductsCollection, Mode=OneWay}"
                          AutomationProperties.Name="Sample Data Grid" SelectionMode="Single">
                    <ListView.Header>
                        <Grid ColumnSpacing="8" Padding="12,0" MinWidth="844">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="70" />
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="240" />
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="130" />
                            </Grid.ColumnDefinitions>
                            <Button AutomationProperties.AutomationId="SortProductId" Content="ID" Tag="ProductId" Click="Sort_Click" />
                            <Button AutomationProperties.AutomationId="SortProductCode" Grid.Column="1" Content="Code" Tag="ProductCode" Click="Sort_Click" />
                            <Button AutomationProperties.AutomationId="SortProductName" Grid.Column="2" Content="Product" Tag="ProductName" Click="Sort_Click" />
                            <Button AutomationProperties.AutomationId="SortQuantity" Grid.Column="3" Content="Quantity" Tag="QuantityPerUnit" Click="Sort_Click" />
                            <Button AutomationProperties.AutomationId="SortPrice" Grid.Column="4" Content="Price" Tag="UnitPrice" Click="Sort_Click" />
                            <Button AutomationProperties.AutomationId="SortStock" Grid.Column="5" Content="Stock" Tag="UnitsInStock" Click="Sort_Click" />
                        </Grid>
                    </ListView.Header>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:Product">
                            <Grid ColumnSpacing="8" MinWidth="820" AutomationProperties.Name="{x:Bind ProductName}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="70" />
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="240" />
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="130" />
                                </Grid.ColumnDefinitions>
                                <TextBox AutomationProperties.AutomationId="{x:Bind AutomationId('ProductID')}" Text="{x:Bind ProductIdInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Product ID" />
                                <TextBox AutomationProperties.AutomationId="{x:Bind AutomationId('ProductCode')}" Grid.Column="1" Text="{x:Bind ProductCodeInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Product Code" />
                                <TextBox AutomationProperties.AutomationId="{x:Bind AutomationId('ProductName')}" Grid.Column="2" Text="{x:Bind ProductName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Product Name" />
                                <TextBox AutomationProperties.AutomationId="{x:Bind AutomationId('QuantityPerUnit')}" Grid.Column="3" Text="{x:Bind QuantityPerUnit, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Quantity Per Unit" />
                                <NumberBox AutomationProperties.AutomationId="{x:Bind AutomationId('UnitPrice')}" Grid.Column="4" Value="{x:Bind UnitPriceInput, Mode=TwoWay}" AutomationProperties.Name="Unit Price" />
                                <TextBox AutomationProperties.AutomationId="{x:Bind AutomationId('UnitsInStock')}" Grid.Column="5" Text="{x:Bind UnitsInStockInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Units In Stock" />
                                <TextBlock Grid.Row="1" Grid.ColumnSpan="6" Text="{x:Bind ValidationError, Mode=OneWay}"
                                           AutomationProperties.AutomationId="{x:Bind AutomationId('ProductValidation')}"
                                           Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                           AutomationProperties.LiveSetting="Polite" TextWrapping="Wrap" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </controls:ControlExample>
        </ScrollViewer>
    </Grid>
</Page>
