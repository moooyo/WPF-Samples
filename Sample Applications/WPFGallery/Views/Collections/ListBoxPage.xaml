<Page
    x:Class="WPFGallery.Views.ListBoxPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:WPFGallery.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:WPFGallery.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    Foreground="{ThemeResource TextFillColorPrimaryBrush}"
    mc:Ignorable="d">

    <Grid x:Name="ContentPagePane">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <controls:PageHeader Margin="0,0,0,32" Title="{x:Bind ViewModel.PageTitle, Mode=OneWay}" ShowDescription="False" />

        <ScrollViewer Grid.Row="1" Margin="0,0,0,24" Padding="0,0,24,0">
            <StackPanel Margin="0,0,0,24">
                <controls:ControlExample
                    Margin="10"
                    HeaderText="ListBox with items defined inline."
                    XamlCode="&lt;ListBox AutomationProperties.Name=&quot;Color ListBox&quot; SelectedIndex=&quot;0&quot;&gt;&#10;    &lt;ListBoxItem&gt;Blue&lt;/ListBoxItem&gt;&#10;    &lt;ListBoxItem&gt;Green&lt;/ListBoxItem&gt;&#10;    &lt;ListBoxItem&gt;Red&lt;/ListBoxItem&gt;&#10;    &lt;ListBoxItem&gt;Yellow&lt;/ListBoxItem&gt;&#10;&lt;/ListBox&gt;">
                    <!---->
                    <ListBox AutomationProperties.Name="Color ListBox" SelectedIndex="0">
                        <ListBoxItem>Blue</ListBoxItem>
                        <ListBoxItem>Green</ListBoxItem>
                        <ListBoxItem>Red</ListBoxItem>
                        <ListBoxItem>Yellow</ListBoxItem>
                    </ListBox>
                </controls:ControlExample>

                <controls:ControlExample
                    Margin="10,36,10,10"
                    HeaderText="A ListBox with its ItemsSource and Height set."
                    XamlCode="&lt;ListBox&#10;    Height=&quot;164&quot;&#10;    AutomationProperties.Name=&quot;Font ListBox&quot;&#10;    ItemsSource=&quot;{x:Bind ViewModel.ListBoxItems, Mode=TwoWay}&quot;&#10;    SelectedIndex=&quot;2&quot; /&gt;">
                    <ListBox
                        Height="164"
                        AutomationProperties.Name="Font ListBox"
                        ItemsSource="{x:Bind ViewModel.ListBoxItems, Mode=TwoWay}"
                        SelectedIndex="2" />
                </controls:ControlExample>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
