<Page
    x:Class="WPFGallery.Views.ListViewPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:WPFGallery.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:WPFGallery.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:WPFGallery.Models"
    d:DesignHeight="450"
    d:DesignWidth="800"
    Foreground="{ThemeResource TextFillColorPrimaryBrush}"
    mc:Ignorable="d">

    <Grid x:Name="ContentPagePane">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <controls:PageHeader Margin="0,0,0,32" Title="{x:Bind ViewModel.PageTitle, Mode=OneWay}" ShowDescription="False" />

        <ScrollViewer Grid.Row="1" Margin="0,0,0,24" Padding="0,0,24,0">
            <StackPanel Margin="0,0,0,24">
                <controls:ControlExample
                    Margin="10"
                    HeaderText="Basic ListView with Simple DataTemplate."
                    XamlCode="&lt;ListView AutomationProperties.AutomationId=&quot;Basic ListView&quot;&#10;    Height=&quot;200&quot;&#10;    AutomationProperties.Name=&quot;Basic ListView&quot;&#10;    ItemsSource=&quot;{x:Bind ViewModel.BasicListViewItems, Mode=OneWay}&quot;&#10;    SelectedIndex=&quot;2&quot;&#10;    SelectionMode=&quot;Single&quot;&gt;&#10;    &lt;ListView.ItemTemplate&gt;&#10;        &lt;DataTemplate x:DataType=&quot;models:Person&quot;&gt;&#10;            &lt;TextBlock Margin=&quot;8,4&quot; Text=&quot;{x:Bind Name}&quot; /&gt;&#10;        &lt;/DataTemplate&gt;&#10;    &lt;/ListView.ItemTemplate&gt;&#10;&lt;/ListView&gt;">
                    <!---->
                    <ListView AutomationProperties.AutomationId="Basic ListView"
                        Height="200"
                        AutomationProperties.Name="Basic ListView"
                        ItemsSource="{x:Bind ViewModel.BasicListViewItems, Mode=OneWay}"
                        SelectedIndex="2"
                        SelectionMode="Single">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:Person">
                                <TextBlock Margin="8,4" Text="{x:Bind Name}" />
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </controls:ControlExample>

                <controls:ControlExample
                    Margin="10,36,10,10"
                    HeaderText="ListView with Selection Support."
                    XamlCode="&lt;Grid&gt;&#10;    &lt;Grid.ColumnDefinitions&gt;&#10;        &lt;ColumnDefinition Width=&quot;*&quot; /&gt;&#10;        &lt;ColumnDefinition Width=&quot;Auto&quot; /&gt;&#10;    &lt;/Grid.ColumnDefinitions&gt;&#10;    &lt;ListView AutomationProperties.AutomationId=&quot;ListView with Selection Support.&quot;&#10;        Grid.Column=&quot;0&quot;&#10;        Height=&quot;200&quot;&#10;        AutomationProperties.Name=&quot;ListView with Selection Support.&quot;&#10;        ItemsSource=&quot;{x:Bind ViewModel.BasicListViewItems, Mode=OneWay}&quot;&#10;        SelectedIndex=&quot;1&quot;&#10;        SelectionMode=&quot;{x:Bind ViewModel.ListViewSelectionMode, Mode=OneWay}&quot;&gt;&#10;        &lt;ListView.ItemTemplate&gt;&#10;            &lt;DataTemplate x:DataType=&quot;models:Person&quot;&gt;&#10;                &lt;Grid Margin=&quot;8,0&quot;&gt;&#10;                    &lt;Grid.RowDefinitions&gt;&#10;                        &lt;RowDefinition Height=&quot;*&quot; /&gt;&#10;                        &lt;RowDefinition Height=&quot;*&quot; /&gt;&#10;                    &lt;/Grid.RowDefinitions&gt;&#10;                    &lt;Grid.ColumnDefinitions&gt;&#10;                        &lt;ColumnDefinition Width=&quot;Auto&quot; /&gt;&#10;                        &lt;ColumnDefinition Width=&quot;*&quot; /&gt;&#10;                    &lt;/Grid.ColumnDefinitions&gt;&#10;                    &lt;Ellipse&#10;                        x:Name=&quot;Ellipse&quot;&#10;                        Grid.RowSpan=&quot;2&quot;&#10;                        Width=&quot;32&quot;&#10;                        Height=&quot;32&quot;&#10;                        Margin=&quot;6&quot;&#10;                        HorizontalAlignment=&quot;Center&quot;&#10;                        VerticalAlignment=&quot;Center&quot;&#10;                        Fill=&quot;{ThemeResource AccentFillColorDefaultBrush}&quot; /&gt;&#10;                    &lt;TextBlock&#10;                        Grid.Row=&quot;0&quot;&#10;                        Grid.Column=&quot;1&quot;&#10;                        Margin=&quot;12,6,0,0&quot;&#10;                        Style=&quot;{StaticResource BodyStrongTextBlockStyle}&quot;&#10;                        Text=&quot;{x:Bind Name}&quot; /&gt;&#10;                    &lt;TextBlock&#10;                        Grid.Row=&quot;1&quot;&#10;                        Grid.Column=&quot;1&quot;&#10;                        Margin=&quot;12,0,0,6&quot;&#10;                        Foreground=&quot;{ThemeResource TextFillColorPrimaryBrush}&quot;&#10;                        Opacity=&quot;{ThemeResource DeemphasizedTextOpacity}&quot;&#10;                        Text=&quot;{x:Bind Company}&quot; /&gt;&#10;                &lt;/Grid&gt;&#10;            &lt;/DataTemplate&gt;&#10;        &lt;/ListView.ItemTemplate&gt;&#10;    &lt;/ListView&gt;&#10;    &lt;StackPanel&#10;        Grid.Column=&quot;1&quot;&#10;        MinWidth=&quot;120&quot;&#10;        Margin=&quot;12,0,0,0&quot;&#10;        VerticalAlignment=&quot;Top&quot;&gt;&#10;        &lt;ContentControl Foreground=&quot;{ThemeResource TextFillColorPrimaryBrush}&quot; Opacity=&quot;{ThemeResource DeemphasizedTextOpacity}&quot; Content=&quot;Selection mode&quot; /&gt;&#10;        &lt;ComboBox AutomationProperties.AutomationId=&quot;SelectionModeComboBox&quot;&#10;            x:Name=&quot;SelectionModeComboBox&quot;&#10;            AutomationProperties.Name=&quot;Selection Mode&quot;&#10;            SelectedIndex=&quot;{x:Bind ViewModel.ListViewSelectionModeComboBoxSelectedIndex, Mode=TwoWay}&quot;&gt;&#10;            &lt;ComboBoxItem Content=&quot;Single&quot; /&gt;&#10;            &lt;ComboBoxItem Content=&quot;Multiple&quot; /&gt;&#10;            &lt;ComboBoxItem Content=&quot;Extended&quot; /&gt;&#10;        &lt;/ComboBox&gt;&#10;    &lt;/StackPanel&gt;&#10;&lt;/Grid&gt;">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ListView AutomationProperties.AutomationId="ListView with Selection Support."
                            Grid.Column="0"
                            Height="200"
                            AutomationProperties.Name="ListView with Selection Support."
                            ItemsSource="{x:Bind ViewModel.BasicListViewItems, Mode=OneWay}"
                            SelectedIndex="1"
                            SelectionMode="{x:Bind ViewModel.ListViewSelectionMode, Mode=OneWay}">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:Person">
                                    <Grid Margin="8,0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Ellipse
                                            x:Name="Ellipse"
                                            Grid.RowSpan="2"
                                            Width="32"
                                            Height="32"
                                            Margin="6"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Fill="{ThemeResource AccentFillColorDefaultBrush}" />
                                        <TextBlock
                                            Grid.Row="0"
                                            Grid.Column="1"
                                            Margin="12,6,0,0"
                                            Style="{StaticResource BodyStrongTextBlockStyle}"
                                            Text="{x:Bind Name}" />
                                        <TextBlock
                                            Grid.Row="1"
                                            Grid.Column="1"
                                            Margin="12,0,0,6"
                                            Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                            Opacity="{ThemeResource DeemphasizedTextOpacity}"
                                            Text="{x:Bind Company}" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <StackPanel
                            Grid.Column="1"
                            MinWidth="120"
                            Margin="12,0,0,0"
                            VerticalAlignment="Top">
                            <ContentControl Foreground="{ThemeResource TextFillColorPrimaryBrush}" Opacity="{ThemeResource DeemphasizedTextOpacity}" Content="Selection mode" />
                            <ComboBox AutomationProperties.AutomationId="SelectionModeComboBox"
                                x:Name="SelectionModeComboBox"
                                AutomationProperties.Name="Selection Mode"
                                SelectedIndex="{x:Bind ViewModel.ListViewSelectionModeComboBoxSelectedIndex, Mode=TwoWay}">
                                <ComboBoxItem Content="Single" />
                                <ComboBoxItem Content="Multiple" />
                                <ComboBoxItem Content="Extended" />
                            </ComboBox>
                        </StackPanel>
                    </Grid>
                </controls:ControlExample>

                <controls:ControlExample
                    Margin="10,36,10,10"
                    HeaderText="ListView with GridView."
                    XamlCode="&lt;ListView AutomationProperties.AutomationId=&quot;ListView with GridView&quot;&#10;    Height=&quot;280&quot;&#10;    AutomationProperties.Name=&quot;ListView with GridView&quot;&#10;    ItemsSource=&quot;{x:Bind ViewModel.GridViewItems, Mode=OneWay}&quot;&gt;&#10;    &lt;ListView.Header&gt;&#10;        &lt;Grid ColumnSpacing=&quot;12&quot;&gt;&#10;            &lt;Grid.ColumnDefinitions&gt;&#10;                &lt;ColumnDefinition Width=&quot;150&quot; /&gt;&#10;                &lt;ColumnDefinition Width=&quot;150&quot; /&gt;&#10;                &lt;ColumnDefinition Width=&quot;200&quot; /&gt;&#10;            &lt;/Grid.ColumnDefinitions&gt;&#10;            &lt;TextBlock Text=&quot;First Name&quot; FontWeight=&quot;SemiBold&quot; /&gt;&#10;            &lt;TextBlock Grid.Column=&quot;1&quot; Text=&quot;Last Name&quot; FontWeight=&quot;SemiBold&quot; /&gt;&#10;            &lt;TextBlock Grid.Column=&quot;2&quot; Text=&quot;Company&quot; FontWeight=&quot;SemiBold&quot; /&gt;&#10;        &lt;/Grid&gt;&#10;    &lt;/ListView.Header&gt;&#10;    &lt;ListView.ItemTemplate&gt;&#10;        &lt;DataTemplate x:DataType=&quot;models:Person&quot;&gt;&#10;            &lt;Grid ColumnSpacing=&quot;12&quot;&gt;&#10;                &lt;Grid.ColumnDefinitions&gt;&#10;                    &lt;ColumnDefinition Width=&quot;150&quot; /&gt;&#10;                    &lt;ColumnDefinition Width=&quot;150&quot; /&gt;&#10;                    &lt;ColumnDefinition Width=&quot;200&quot; /&gt;&#10;                &lt;/Grid.ColumnDefinitions&gt;&#10;                &lt;TextBlock Text=&quot;{x:Bind FirstName}&quot; /&gt;&#10;                &lt;TextBlock Grid.Column=&quot;1&quot; Text=&quot;{x:Bind LastName}&quot; /&gt;&#10;                &lt;TextBlock Grid.Column=&quot;2&quot; Text=&quot;{x:Bind Company}&quot; /&gt;&#10;            &lt;/Grid&gt;&#10;        &lt;/DataTemplate&gt;&#10;    &lt;/ListView.ItemTemplate&gt;&#10;&lt;/ListView&gt;">
                    <ListView AutomationProperties.AutomationId="ListView with GridView"
                        Height="280"
                        AutomationProperties.Name="ListView with GridView"
                        ItemsSource="{x:Bind ViewModel.GridViewItems, Mode=OneWay}">
                        <ListView.Header>
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="200" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="First Name" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="1" Text="Last Name" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="2" Text="Company" FontWeight="SemiBold" />
                            </Grid>
                        </ListView.Header>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:Person">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="200" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Bind FirstName}" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind LastName}" />
                                    <TextBlock Grid.Column="2" Text="{x:Bind Company}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </controls:ControlExample>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
