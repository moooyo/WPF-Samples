<Page x:Class="WPFGallery.Views.IconsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:WPFGallery.Controls"
    xmlns:models="using:WPFGallery.Models">
    <Grid RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <controls:PageHeader Title="{x:Bind ViewModel.PageTitle}" Description="{x:Bind ViewModel.PageDescription}" />
        <TextBox AutomationProperties.AutomationId="IconsSearchBox" x:Name="IconsSearchBox" Grid.Row="1" Header="Search icons"
                 PlaceholderText="Search by name or tag"
                 Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        <Grid Grid.Row="2" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="280" />
            </Grid.ColumnDefinitions>
            <GridView AutomationProperties.AutomationId="Icons" ItemsSource="{x:Bind ViewModel.DisplayedIcons, Mode=OneWay}"
                      SelectedItem="{x:Bind ViewModel.SelectedIcon, Mode=TwoWay}"
                      SelectionMode="Single" AutomationProperties.Name="Icons">
                <GridView.ItemTemplate>
                    <DataTemplate x:DataType="models:IconData">
                        <StackPanel Width="100" Height="96" Padding="8" Spacing="12"
                                    AutomationProperties.Name="{x:Bind Name}">
                            <FontIcon Glyph="{x:Bind Character}" FontFamily="{StaticResource SymbolThemeFontFamily}" FontSize="28" />
                            <TextBlock Text="{x:Bind Name}" FontSize="12" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>
            <ScrollViewer Grid.Column="1">
                <StackPanel Spacing="8">
                    <TextBlock AutomationProperties.AutomationId="SelectedIconName" Text="{x:Bind ViewModel.SelectedIcon.Name, Mode=OneWay}" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <FontIcon Glyph="{x:Bind ViewModel.SelectedIcon.Character, Mode=OneWay}" FontSize="50" HorizontalAlignment="Left" />
                    <TextBlock Text="Icon Name" />
                    <controls:IconDataField Value="{x:Bind ViewModel.SelectedIcon.Name, Mode=OneWay}" Label="Copy Icon Name" />
                    <TextBlock Text="Unicode point" />
                    <controls:IconDataField Value="{x:Bind ViewModel.SelectedIcon.Code, Mode=OneWay}" Label="Copy Unicode Point" />
                    <TextBlock Text="Text glyph" />
                    <controls:IconDataField Value="{x:Bind ViewModel.SelectedIcon.TextGlyph, Mode=OneWay}" Label="Copy Text Glyph" />
                    <TextBlock Text="Code glyph" />
                    <controls:IconDataField Value="{x:Bind ViewModel.SelectedIcon.CodeGlyph, Mode=OneWay}" Label="Copy Code Glyph" />
                    <TextBlock Text="Tags" />
                    <ItemsControl ItemsSource="{x:Bind ViewModel.SelectedIcon.Tags, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <Button AutomationProperties.AutomationId="Tag_Click" Content="{x:Bind}" Click="Tag_Click" Margin="0,0,0,4" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="XAML" />
                    <controls:IconDataField Value="{x:Bind ViewModel.SelectedIcon.XamlCode, Mode=OneWay}" Label="Copy XAML Code" />
                    <HyperlinkButton AutomationProperties.AutomationId="Open_SegoeFontDownloadPage" Content="Download Segoe Fluent Icons" Click="Open_SegoeFontDownloadPage" />
                    <HyperlinkButton AutomationProperties.AutomationId="Open_IconDesignGuidelinesPage" Content="Icon design guidelines" Click="Open_IconDesignGuidelinesPage" />
                </StackPanel>
            </ScrollViewer>
        </Grid>
        <Grid Grid.Row="3" Margin="0,0,0,24">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button AutomationProperties.AutomationId="IconsPreviousPage" Content="Previous" Command="{x:Bind ViewModel.PreviousPageCommand}" AutomationProperties.Name="Previous Page" />
                <TextBlock AutomationProperties.AutomationId="IconsCurrentPage" Text="{x:Bind ViewModel.CurrentPage, Mode=OneWay}" VerticalAlignment="Center" />
                <TextBlock Text="of" VerticalAlignment="Center" />
                <TextBlock AutomationProperties.AutomationId="IconsTotalPages" Text="{x:Bind ViewModel.TotalPages, Mode=OneWay}" VerticalAlignment="Center" />
                <Button AutomationProperties.AutomationId="IconsNextPage" Content="Next" Command="{x:Bind ViewModel.NextPageCommand}" AutomationProperties.Name="Next Page" />
            </StackPanel>
            <ComboBox AutomationProperties.AutomationId="IconsPageSize" Header="Icons per page" HorizontalAlignment="Right"
                      ItemsSource="{x:Bind ViewModel.PageSizeOptions}"
                      SelectedIndex="{x:Bind ViewModel.SelectedPageSizeIndex, Mode=TwoWay}" />
        </Grid>
    </Grid>
</Page>
