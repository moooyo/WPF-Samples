Style=&quot;{StaticResource CaptionTextBlockStyle}&quot;&#10;        Text=&quot;Size/Line height&quot; /&gt;&#10;            &lt;TextBlock&#10;        Grid.Column=&quot;3&quot;&#10;        Foreground=&quot;{StaticResource TextFillColorPrimaryBrush}&quot;&#10;        Opacity=&quot;{ThemeResource DeemphasizedTextOpacity}&quot;&#10;        Style=&quot;{StaticResource CaptionTextBlockStyle}&quot;&#10;        Text=&quot;Style&quot; /&gt;&#10;        &lt;/Grid&gt;&#10;    &lt;/StackPanel&gt;&#10;    &lt;StackPanel Grid.Row=&quot;1&quot;&gt;&#10;        &lt;Grid HorizontalAlignment=&quot;Stretch&quot; Background=&quot;{StaticResource CardBackgroundFillColorDefaultBrush}&quot; MinHeight=&quot;68&quot;&gt;&#10;            &lt;Grid.ColumnDefinitions&gt;&#10;                &lt;ColumnDefinition Width=&quot;272&quot; /&gt;&#10;                &lt;ColumnDefinition Width=&quot;136&quot; /&gt;&#10;                &lt;ColumnDefinition Width=&quot;112&quot; /&gt;&#10;                &lt;ColumnDefinition Width=&quot;164&quot; /&gt;&#10;            &lt;/Grid.ColumnDefinitions&gt;&#10;            &lt;TextBlock&#10;        Margin=&quot;16,0,0,0&quot;&#10;        VerticalAlignment=&quot;Center&quot;&#10;        Style=&quot;{StaticResource CaptionTextBlockStyle}&quot;&#10;        Text=&quot;Caption&quot; /&gt;&#10;            &lt;TextBlock&#10;        Grid.Column=&quot;1&quot;&#10;        VerticalAlignment=&quot;Center&quot;&#10;        Style=&quot;{StaticResource CaptionTextBlockStyle}&quot;&#10;        Text=&quot;Small, Regular&quot; /&gt;&#10;            &lt;TextBlock&#10;        Grid.Column=&quot;2&quot;&#10;        VerticalAlignment=&quot;Center&quot;&#10;        Style=&quot;{StaticResource CaptionTextBlockStyle}&quot;&#10;        Text=&quot;12/16 epx&quot; /&gt;&#10;            &lt;TextBlock&#10;        Grid.Column=&quot;3&quot;&#10;        VerticalAlignment=&quot;Center&quot;&#10;        Style=&quot;{StaticResource CaptionTextBlockStyle}&quot;&#10;        Text=&quot;CaptionTextBlockStyle&quot; /&gt;&#10;        &lt;/Grid&gt;&#10;    &lt;/StackPanel&gt;&#10;    &lt;StackPanel Grid.Row=&quot;2&quot;&gt;&#10;        &lt;Grid HorizontalAlignment=&quot;Stretch&quot; MinHeight=&quot;68&quot;&gt;&#10;            &lt;Grid.ColumnDefinitions&gt;&#10;                &lt;ColumnDefinition Width=&quot;272&quot; /&gt;&#10;                &lt;ColumnDefinition Width=&quot;136&quot; /&gt;&#10;                &lt;ColumnDefinition Width=&quot;112&quot; /&gt;&#10;                &lt;ColumnDefinition Width=&quot;164&quot; /&gt;&#10;            &lt;/Grid.ColumnDefinitions&gt;&#10;            &lt;TextBlock&#10;        Margin=&quot;16,0,0,0&quot;&#10;        VerticalAlignment=&quot;Center&quot;&#10;        Style=&quot;{StaticResource BodyTextBlockStyle}&quot;&#10;        Text=&quot;Body&quot; /&gt;&#10;            &lt;TextBlock&#10;        Grid.Column=&quot;1&quot;&#10;        VerticalAlignment=&quot;Center&quot;&#10;        Style=&quot;{StaticResource CaptionTextBlockStyle}&quot;&#10;        Text=&quot;Text, Regular&quot; /&gt;&#10;            &lt;TextBlock&#10;        Grid.Column=&quot;2&quot;&#10;        VerticalAlignment=&quot;Center&quot;&#10;        Style=&quot;{StaticResource CaptionTextBlockStyle}&quot;&#10;        Text=&quot;14/20 epx&quot; /&gt;&#10;            &lt;TextBlock&#10;        Grid.Column=&quot;3&quot;&#10;        VerticalAlignment=&quot;Center&quot;&#10;        Style=&quot;{StaticResource CaptionTextBlockStyle}&quot;&#10;        Text=&quot;BodyTextBlockStyle&quot; /&gt;&#10;        &lt;/Grid&gt;&#10;    &lt;/StackPanel&gt;&#10;    &lt;StackPanel Grid.Row=&quot;3&quot;&gt;&#10;        &lt;Grid HorizontalAlignment=&quot;Stretch&quot; Background=&quot;{StaticResource CardBackgroundFillColorDefaultBrush}&quot; MinHeight=&quot;68&quot;&gt;&#10;            &lt;Grid.ColumnDefinitions&gt;&#10;                &lt;ColumnDefinition Width=&quot;272&quot; /&gt;&#10;                &lt;ColumnDefinition Width=&quot;136&quot; /&gt;&#10;                &lt;ColumnDefinition Width=&quot;112&quot; /&gt;&#10;                &lt;ColumnDefinition Width=&quot;164&quot; /&gt;&#10;            &lt;/Grid.ColumnDefinitions&gt;&#10;            &lt;TextBlock&#10;        Margin=&quot;16,0,0,0&quot;&#10;        VerticalAlignment=&quot;Center&quot;&#10;        Style=&quot;{StaticResource BodyStrongTextBlockStyle}&quot;&#10;        Text=&quot;Body Strong&quot; /&gt;&#10;            &lt;TextBlock&#10;        Grid.Column=&quot;1&quot;&#10;        VerticalAlignment=&quot;Center&quot;&#10;        Style=&quot;{StaticResource CaptionTextBlockStyle}&quot;&#10;        Text=&quot;Text, SemiBold&quot; /&gt;&#10;            &lt;TextBlock&#10;        Grid.Column=&quot;2&quot;&#10;        VerticalAlignment=&quot;Center&quot;&#10;        Style=&quot;{StaticResource CaptionTextBlockStyle}&quot;&#10;        Text=&quot;14/20 epx&quot; /&gt;&#10;            &lt;TextBlock&#10;        Grid.Column=&quot;3&quot;&#10;        VerticalAlignment=&quot;Center&quot;&#10;        Style=&quot;{StaticResource CaptionTextBlockStyle}&quot;&#10;        Text=&quot;CaptionTextBlockStyle&quot; /&gt;&#10;        &lt;/Grid&gt;&#10;    &lt;/StackPanel&gt;&#10;    &lt;StackPanel Grid.Row=&quot;4&quot;&gt;&#10;        &lt;Grid HorizontalAlignment=&quot;Stretch&quot; MinHeight=&quot;68&quot;&gt;&#10;            &lt;Grid.ColumnDefinitions&gt; &#10;                &lt;ColumnDefinition Width=&quot;272&quot; /&gt;&#10;                &lt;ColumnDefinition Width=&quot;136&quot; /&gt;&#10;                &lt;ColumnDefinition Width=&quot;112&quot; /&gt;&#10;                &lt;ColumnDefinition Width=&quot;164&quot; /&gt;&#10;            &lt;/Grid.ColumnDefinitions&gt;&#10;            &lt;TextBlock&#10;        Margin=&quot;16,0,0,0&quot;&#10;        VerticalAlignment=&quot;Center&quot;&#10;        Style=&quot;{StaticResource SubtitleTextBlockStyle}&quot;&#10;        Text=&quot;Subtitle&quot; /&gt;&#10;            &lt;TextBlock&#10;        Grid.Column=&quot;1&quot;&#10;        VerticalAlignment