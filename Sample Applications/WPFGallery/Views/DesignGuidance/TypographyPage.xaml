                        Text="Title" />
                            <TextBlock
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="Display, SemiBold" />
                            <TextBlock
                        Grid.Column="2"
                        VerticalAlignment="Center"
