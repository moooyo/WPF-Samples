<Page x:Class="WPFGallery.Views.GeometryPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="using:WPFGallery.Views"
      mc:Ignorable="d" Foreground="{ThemeResource TextFillColorPrimaryBrush}"
      xmlns:controls="using:WPFGallery.Controls"
      d:DesignHeight="450" d:DesignWidth="800">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <controls:PageHeader Margin="0,0,0,32" Title="{x:Bind ViewModel.PageTitle, Mode=OneWay}" ShowDescription="False"/>

        <ScrollViewer Margin="0,0,0,24" Padding="0,0,24,0" HorizontalScrollBarVisibility="Auto" Grid.Row="1">
                <StackPanel Margin="0,0,0,24" Orientation="Vertical">
                <TextBlock HorizontalAlignment="Left" TextWrapping="Wrap">
                    Geometry describes the shape, size and position of UI elements on screen.
                </TextBlock>
                <TextBlock HorizontalAlignment="Left" TextWrapping="Wrap">
                    These fundamental design elements help experiences feel coherent across the entire design system.
                </TextBlock>
                <TextBlock HorizontalAlignment="Left" TextWrapping="Wrap" Margin="0,0,0,12">
                    You can reference built-in corner radii styles using: CornerRadius="{StaticResource ControlCornerRadius}" .
                </TextBlock>
				<Border Height="300" Width="500" HorizontalAlignment="Left">
					<Image x:Name="GeometryImage" Source="/Assets/Design/Geometry.dark.png" AutomationProperties.Name="Example of corner radius." />
				</Border>
                <controls:ControlExample
                    XamlCode="&lt;Grid&gt;&#10;    &lt;Grid.RowDefinitions&gt;&#10;        &lt;RowDefinition Height=&quot;Auto&quot;/&gt;&#10;        &lt;RowDefinition Height=&quot;Auto&quot;/&gt;&#10;        &lt;RowDefinition Height=&quot;Auto&quot;/&gt;&#10;        &lt;RowDefinition Height=&quot;Auto&quot;/&gt;&#10;    &lt;/Grid.RowDefinitions&gt;&#10;    &#10;    &lt;StackPanel Grid.Row=&quot;0&quot;&gt;&#10;        &lt;Grid Margin=&quot;0,0,0,24&quot; HorizontalAlignment=&quot;Stretch&quot;&gt;&#10;            &lt;Grid.ColumnDefinitions&gt;&#10;                &lt;ColumnDefinition Width=&quot;148&quot; /&gt;&#10;                &lt;ColumnDefinition Width=&quot;400&quot; /&gt;&#10;                &lt;ColumnDefinition Width=&quot;*&quot; /&gt;&#10;            &lt;/Grid.ColumnDefinitions&gt;&#10;            &lt;TextBlock&#10;                    Margin=&quot;16,0,0,0&quot;&#10;                    Foreground=&quot;{ThemeResource TextFillColorPrimaryBrush}&quot;&#10;                    Opacity=&quot;{ThemeResource DeemphasizedTextOpacity}&quot;&#10;                    Style=&quot;{StaticResource CaptionTextBlockStyle}&quot;&#10;                    Text=&quot;Corner radius&quot; /&gt;&#10;            &lt;TextBlock&#10;                    Grid.Column=&quot;1&quot;&#10;                    Margin=&quot;16,0,0,0&quot;&#10;                    Foreground=&quot;{ThemeResource TextFillColorPrimaryBrush}&quot;&#10;                    Opacity=&quot;{ThemeResource DeemphasizedTextOpacity}&quot;&#10;                    Style=&quot;{StaticResource CaptionTextBlockStyle}&quot;&#10;                    Text=&quot;Usage&quot; /&gt;&#10;            &lt;TextBlock&#10;                    Grid.Column=&quot;2&quot;&#10;                    Margin=&quot;16,0,0,0&quot;&#10;                    Foreground=&quot;{ThemeResource TextFillColorPrimaryBrush}&quot;&#10;                    Opacity=&quot;{ThemeResource DeemphasizedTextOpacity}&quot;&#10;                    Style=&quot;{StaticResource CaptionTextBlockStyle}&quot;&#10;                    Text=&quot;Style&quot; /&gt;&#10;        &lt;/Grid&gt;&#10;    &lt;/StackPanel&gt;&#10;&#10;    &#10;    &lt;StackPanel Grid.Row=&quot;1&quot;&gt;&#10;        &lt;Border Background=&quot;{ThemeResource CardBackgroundFillColorDefaultBrush}&quot;&gt;&#10;            &lt;Grid HorizontalAlignment=&quot;Stretch&quot; MinHeight=&quot;60&quot;&gt;&#10;                &lt;Grid.ColumnDefinitions&gt;&#10;                    &lt;ColumnDefinition Width=&quot;148&quot; /&gt;&#10;                    &lt;ColumnDefinition Width=&quot;400&quot; /&gt;&#10;                    &lt;ColumnDefinition Width=&quot;*&quot; /&gt;&#10;                &lt;/Grid.ColumnDefinitions&gt;&#10;                &lt;StackPanel Grid.Column=&quot;0&quot; Orientation=&quot;Horizontal&quot;&gt;&#10;                    &lt;Border&#10;                       Width=&quot;20&quot;&#10;                       Height=&quot;20&quot;&#10;                       Background=&quot;{ThemeResource AccentFillColorDefaultBrush}&quot;&#10;                       CornerRadius=&quot;{ThemeResource OverlayCornerRadius}&quot;&#10;                       VerticalAlignment=&quot;Center&quot;&#10;                       Margin=&quot;16,0,0,0&quot;/&gt;&#10;                    &lt;TextBlock&#10;                            Margin=&quot;16,0,0,0&quot;&#10;                            VerticalAlignment=&quot;Center&quot;&#10;                            Style=&quot;{StaticResource BodyTextBlockStyle}&quot;&#10;                            Text=&quot;8px&quot; /&gt;&#10;                &lt;/StackPanel&gt;&#10;                &lt;TextBlock&#10;                        Margin=&quot;16,0,0,0&quot;&#10;                        Grid.Column=&quot;1&quot;&#10;                        VerticalAlignment=&quot;Center&quot;&#10;                        TextWrapping=&quot;Wrap&quot;&#10;                        Style=&quot;{StaticResource CaptionTextBlockStyle}&quot;&#10;                        Text=&quot;Top-level containers such as app windows, flyouts, cards and dialogs.&quot;/&gt;&#10;                &lt;TextBlock&#10;                        Margin=&quot;16,0,0,0&quot;&#10;                        Grid.Column=&quot;2&quot;&#10;                        VerticalAlignment=&quot;Center&quot;&#10;                        TextWrapping=&quot;Wrap&quot;&#10;                        Style=&quot;{StaticResource CaptionTextBlockStyle}&quot;&#10;                        Text=&quot;OverlayCornerRadius&quot; /&gt;&#10;            &lt;/Grid&gt;&#10;        &lt;/Border&gt;&#10;    &lt;/StackPanel&gt;&#10;&#10;    &#10;    &lt;StackPanel Grid.Row=&quot;2&quot;&gt;&#10;        &lt;Border&gt;&#10;            &lt;Grid HorizontalAlignment=&quot;Stretch&quot; MinHeight=&quot;60&quot;&gt;&#10;                &lt;Grid.ColumnDefinitions&gt;&#10;                    &lt;ColumnDefinition Width=&quot;148&quot; /&gt;&#10;                    &lt;ColumnDefinition Width=&quot;400&quot; /&gt;&#10;                    &lt;ColumnDefinition Width=&quot;*&quot; /&gt;&#10;                &lt;/Grid.ColumnDefinitions&gt;&#10;                &lt;StackPanel Grid.Column=&quot;0&quot; Orientation=&quot;Horizontal&quot;&gt;&#10;                    &lt;Border&#10;                       Width=&quot;20&quot;&#10;                       Height=&quot;20&quot;&#10;                       Background=&quot;{ThemeResource AccentFillColorDefaultBrush}&quot;&#10;                       CornerRadius=&quot;{ThemeResource ControlCornerRadius}&quot;&#10;                       VerticalAlignment=&quot;Center&quot;&#10;                       Margin=&quot;16,0,0,0&quot;/&gt;&#10;                    &lt;TextBlock&#10;                            Margin=&quot;16,0,0,0&quot;&#10;                            VerticalAlignment=&quot;Center&quot;&#10;                            Style=&quot;{StaticResource BodyTextBlockStyle}&quot;&#10;                            Text=&quot;4px&quot; /&gt;&#10;                &lt;/StackPanel&gt;&#10;                &lt;TextBlock&#10;                        Margin=&quot;16,0,0,0&quot;&#10;                        Grid.Column=&quot;1&quot;&#10;                        VerticalAlignment=&quot;Center&quot;&#10;                        TextWrapping=&quot;Wrap&quot;&#10;                        Style=&quot;{StaticResource CaptionTextBlockStyle}&quot;&#10;                        Text=&quot;In-page elements such as controls and list backplates.&quot;/&gt;&#10;                &lt;TextBlock&#10;                        Margin=&quot;16,0,0,0&quot;&#10;                        Grid.Column=&quot;2&quot;&#10;                        VerticalAlignment=&quot;Center&quot;&#10;                        TextWrapping=&quot;Wrap&quot;&#10;                        Style=&quot;{StaticResource CaptionTextBlockStyle}&quot;&#10;                        Text=&quot;ControlCornerRadius&quot; /&gt;&#10;            &lt;/Grid&gt;&#10;        &lt;/Border&gt;&#10;    &lt;/StackPanel&gt;&#10;&#10;    &#10;    &lt;StackPanel Grid.Row=&quot;3&quot;&gt;&#10;        &lt;Border Background=&quot;{ThemeResource CardBackgroundFillColorDefaultBrush}&quot;&gt;&#10;            &lt;Grid HorizontalAlignment=&quot;Stretch&quot; MinHeight=&quot;60&quot;&gt;&#10;                &lt;Grid.ColumnDefinitions&gt;&#10;                    &lt;ColumnDefinition Width=&quot;148&quot; /&gt;&#10;                    &lt;ColumnDefinition Width=&quot;400&quot; /&gt;&#10;                    &lt;ColumnDefinition Width=&quot;*&quot; /&gt;&#10;                &lt;/Grid.ColumnDefinitions&gt;&#10;                &lt;StackPanel Grid.Column=&quot;0&quot; Orientation=&quot;Horizontal&quot;&gt;&#10;                    &lt;Border&#10;                       Width=&quot;20&quot;&#10;                       Height=&quot;20&quot;&#10;                       Background=&quot;{ThemeResource AccentFillColorDefaultBrush}&quot;&#10;                       VerticalAlignment=&quot;Center&quot;&#10;                       Margin=&quot;16,0,0,0&quot;/&gt;&#10;                    &lt;TextBlock&#10;                            Margin=&quot;16,0,0,0&quot;&#10;                            VerticalAlignment=&quot;Center&quot;&#10;                            Style=&quot;{StaticResource BodyTextBlockStyle}&quot;&#10;                            Text=&quot;0px&quot; /&gt;&#10;                &lt;/StackPanel&gt;&#10;                &lt;TextBlock&#10;                        Margin=&quot;16,0,0,0&quot;&#10;                        Grid.Column=&quot;1&quot;&#10;                        VerticalAlignment=&quot;Center&quot;&#10;                        TextWrapping=&quot;Wrap&quot;&#10;                        Style=&quot;{StaticResource CaptionTextBlockStyle}&quot;&#10;                        Text=&quot;Straight edges that intersect with other straight edges.&quot;/&gt;&#10;                &lt;TextBlock&#10;                        Margin=&quot;16,0,0,0&quot;&#10;                        Grid.Column=&quot;2&quot;&#10;                        VerticalAlignment=&quot;Center&quot;&#10;                        TextWrapping=&quot;Wrap&quot;&#10;                        Style=&quot;{StaticResource CaptionTextBlockStyle}&quot;&#10;                        Text=&quot;N/A&quot; /&gt;&#10;            &lt;/Grid&gt;&#10;        &lt;/Border&gt;&#10;    &lt;/StackPanel&gt;&#10;&lt;/Grid&gt;">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <!-- Header Row -->
                        <StackPanel Grid.Row="0">
                            <Grid Margin="0,0,0,24" HorizontalAlignment="Stretch">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="148" />
                                    <ColumnDefinition Width="400" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                        Margin="16,0,0,0"
                                        Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                        Opacity="{ThemeResource DeemphasizedTextOpacity}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="Corner radius" />
                                <TextBlock
                                        Grid.Column="1"
                                        Margin="16,0,0,0"
                                        Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                        Opacity="{ThemeResource DeemphasizedTextOpacity}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="Usage" />
                                <TextBlock
                                        Grid.Column="2"
                                        Margin="16,0,0,0"
                                        Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                        Opacity="{ThemeResource DeemphasizedTextOpacity}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="Style" />
                            </Grid>
                        </StackPanel>

                        <!-- 8px (Overlay Corner Radius) -->
                        <StackPanel Grid.Row="1">
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                                <Grid HorizontalAlignment="Stretch" MinHeight="60">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="148" />
                                        <ColumnDefinition Width="400" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                                        <Border
                                           Width="20"
                                           Height="20"
                                           Background="{ThemeResource AccentFillColorDefaultBrush}"
                                           CornerRadius="{ThemeResource OverlayCornerRadius}"
                                           VerticalAlignment="Center"
                                           Margin="16,0,0,0"/>
                                        <TextBlock
                                                Margin="16,0,0,0"
                                                VerticalAlignment="Center"
                                                Style="{StaticResource BodyTextBlockStyle}"
                                                Text="8px" />
                                    </StackPanel>
                                    <TextBlock
                                            Margin="16,0,0,0"
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            TextWrapping="Wrap"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Text="Top-level containers such as app windows, flyouts, cards and dialogs."/>
                                    <TextBlock
                                            Margin="16,0,0,0"
                                            Grid.Column="2"
                                            VerticalAlignment="Center"
                                            TextWrapping="Wrap"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Text="OverlayCornerRadius" />
                                </Grid>
                            </Border>
                        </StackPanel>

                        <!-- 4px (ControlCornerRadius) -->
                        <StackPanel Grid.Row="2">
                            <Border>
                                <Grid HorizontalAlignment="Stretch" MinHeight="60">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="148" />
                                        <ColumnDefinition Width="400" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                                        <Border
                                           Width="20"
                                           Height="20"
                                           Background="{ThemeResource AccentFillColorDefaultBrush}"
                                           CornerRadius="{ThemeResource ControlCornerRadius}"
                                           VerticalAlignment="Center"
                                           Margin="16,0,0,0"/>
                                        <TextBlock
                                                Margin="16,0,0,0"
                                                VerticalAlignment="Center"
                                                Style="{StaticResource BodyTextBlockStyle}"
                                                Text="4px" />
                                    </StackPanel>
                                    <TextBlock
                                            Margin="16,0,0,0"
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            TextWrapping="Wrap"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Text="In-page elements such as controls and list backplates."/>
                                    <TextBlock
                                            Margin="16,0,0,0"
                                            Grid.Column="2"
                                            VerticalAlignment="Center"
                                            TextWrapping="Wrap"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Text="ControlCornerRadius" />
                                </Grid>
                            </Border>
                        </StackPanel>

                        <!-- 0px-->
                        <StackPanel Grid.Row="3">
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                                <Grid HorizontalAlignment="Stretch" MinHeight="60">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="148" />
                                        <ColumnDefinition Width="400" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                                        <Border
                                           Width="20"
                                           Height="20"
                                           Background="{ThemeResource AccentFillColorDefaultBrush}"
                                           VerticalAlignment="Center"
                                           Margin="16,0,0,0"/>
                                        <TextBlock
                                                Margin="16,0,0,0"
                                                VerticalAlignment="Center"
                                                Style="{StaticResource BodyTextBlockStyle}"
                                                Text="0px" />
                                    </StackPanel>
                                    <TextBlock
                                            Margin="16,0,0,0"
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            TextWrapping="Wrap"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Text="Straight edges that intersect with other straight edges."/>
                                    <TextBlock
                                            Margin="16,0,0,0"
                                            Grid.Column="2"
                                            VerticalAlignment="Center"
                                            TextWrapping="Wrap"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Text="N/A" />
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Grid>
                </controls:ControlExample>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>

