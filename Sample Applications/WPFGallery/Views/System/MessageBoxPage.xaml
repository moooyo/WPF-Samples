<Page
    x:Class="WPFGallery.Views.MessageBoxPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:WPFGallery.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:WPFGallery.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    Foreground="{ThemeResource TextFillColorPrimaryBrush}"
    mc:Ignorable="d">

    <Grid x:Name="ContentPagePane">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <controls:PageHeader Margin="0,0,0,32" Title="{x:Bind ViewModel.PageTitle, Mode=OneWay}" ShowDescription="False" />

        <ScrollViewer Grid.Row="1" Margin="0,0,0,24" Padding="0,0,24,0">
            <StackPanel>
                <controls:ControlExample
                    Margin="10"
                    HeaderText="Simple MessageBox"
                    XamlCode="&lt;StackPanel&gt;&#10;    &lt;Button AutomationProperties.AutomationId=&quot;ShowDefaultMessageButton_Click&quot; &#10;        Content=&quot;Simple MessageBox&quot; &#10;        Click=&quot;ShowDefaultMessageButton_Click&quot;&#10;        Margin=&quot;0,0,0,10&quot; /&gt;&#10;    &lt;TextBlock &#10;        Text=&quot;{x:Bind ViewModel.DefaultMessageResult, Mode=OneWay}&quot;&#10;        TextWrapping=&quot;Wrap&quot; /&gt;&#10;&lt;/StackPanel&gt;"
                    CSharpCode="private async void ShowDefaultMessageButton_Click(object sender, RoutedEventArgs e)&#10;        {&#10;            var result = await App.Services.GetRequiredService&lt;IDialogService&gt;().ShowAsync(XamlRoot, &quot;This is a simple message box!&quot;);&#10;            ViewModel.DefaultMessageResult = $&quot;Result: {result}&quot;;&#10;        }">
                    <StackPanel>
                        <Button AutomationProperties.AutomationId="ShowDefaultMessageButton_Click"
                            Content="Simple MessageBox"
                            Click="ShowDefaultMessageButton_Click"
                            Margin="0,0,0,10" />
                        <TextBlock
                            Text="{x:Bind ViewModel.DefaultMessageResult, Mode=OneWay}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </controls:ControlExample>

                <controls:ControlExample
                    Margin="10,32,10,10"
                    HeaderText="MessageBox with Custom Title and Description"
                    XamlCode="&lt;StackPanel&gt;&#10;    &lt;Button AutomationProperties.AutomationId=&quot;ShowCustomTitleButton_Click&quot; &#10;        Content=&quot;Custom MessageBox&quot;&#10;        Click=&quot;ShowCustomTitleButton_Click&quot;&#10;        Margin=&quot;0,0,0,10&quot; /&gt;&#10;    &lt;TextBlock &#10;        Text=&quot;{x:Bind ViewModel.CustomTitleResult, Mode=OneWay}&quot;&#10;        TextWrapping=&quot;Wrap&quot; /&gt;&#10;&lt;/StackPanel&gt;"
                    CSharpCode="private async void ShowCustomTitleButton_Click(object sender, RoutedEventArgs e)&#10;        {&#10;            var result = await App.Services.GetRequiredService&lt;IDialogService&gt;().ShowAsync(XamlRoot, &quot;This is a detailed description of what happened or what action is needed.&quot;, &quot;Custom Title&quot;);&#10;            ViewModel.CustomTitleResult = $&quot;Result: {result}&quot;;&#10;        }">
                    <StackPanel>
                        <Button AutomationProperties.AutomationId="ShowCustomTitleButton_Click"
                            Content="Custom MessageBox"
                            Click="ShowCustomTitleButton_Click"
                            Margin="0,0,0,10" />
                        <TextBlock
                            Text="{x:Bind ViewModel.CustomTitleResult, Mode=OneWay}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </controls:ControlExample>

                <controls:ControlExample
                    Margin="10,32,10,10"
                    HeaderText="MessageBox with Different Buttons"
                    XamlCode="&lt;Grid&gt;&#10;    &lt;Grid.ColumnDefinitions&gt;&#10;        &lt;ColumnDefinition Width=&quot;*&quot; /&gt;&#10;        &lt;ColumnDefinition Width=&quot;Auto&quot; /&gt;&#10;    &lt;/Grid.ColumnDefinitions&gt;&#10;    &lt;StackPanel Grid.Column=&quot;0&quot;&gt;&#10;        &lt;Button AutomationProperties.AutomationId=&quot;MessageBox with Different Buttons&quot; &#10;            Content=&quot;Show MessageBox&quot; &#10;            AutomationProperties.Name=&quot;MessageBox with Different Buttons&quot;&#10;            Click=&quot;ShowButtonFromComboBox_Click&quot;&#10;            Margin=&quot;0,0,0,10&quot; /&gt;&#10;        &lt;TextBlock &#10;            AutomationProperties.AutomationId=&quot;DialogButtonsResult&quot;&#10;            Text=&quot;{x:Bind ViewModel.DifferentButtonsResult, Mode=OneWay}&quot;&#10;            TextWrapping=&quot;Wrap&quot; /&gt;&#10;    &lt;/StackPanel&gt;&#10;    &lt;StackPanel Grid.Column=&quot;1&quot; Margin=&quot;10,0,0,0&quot;&gt;&#10;        &lt;TextBlock Text=&quot;Button Type:&quot; Margin=&quot;0,0,0,5&quot; /&gt;&#10;        &lt;ComboBox AutomationProperties.AutomationId=&quot;ButtonTypeComboBox&quot; &#10;            x:Name=&quot;ButtonTypeComboBox&quot;&#10;            AutomationProperties.Name=&quot;MessageBox Button Selector&quot;&#10;            SelectedIndex=&quot;{x:Bind ViewModel.SelectedButtonIndex, Mode=TwoWay}&quot;&#10;            MinWidth=&quot;150&quot;&gt;&#10;            &lt;ComboBoxItem Content=&quot;OK&quot; /&gt;&#10;            &lt;ComboBoxItem Content=&quot;OK/Cancel&quot; /&gt;&#10;            &lt;ComboBoxItem Content=&quot;Abort/Retry/Ignore&quot; /&gt;&#10;            &lt;ComboBoxItem Content=&quot;Yes/No/Cancel&quot; /&gt;&#10;            &lt;ComboBoxItem Content=&quot;Yes/No&quot; /&gt;&#10;            &lt;ComboBoxItem Content=&quot;Retry/Cancel&quot; /&gt;&#10;            &lt;ComboBoxItem Content=&quot;Cancel/Try/Continue&quot; /&gt;&#10;        &lt;/ComboBox&gt;&#10;    &lt;/StackPanel&gt;&#10;&lt;/Grid&gt;"
                    CSharpCode="private async void ShowButtonFromComboBox_Click(object sender, RoutedEventArgs e)&#10;        {&#10;            DialogButtons buttonType = ViewModel.SelectedButtonIndex switch&#10;            {&#10;                0 =&gt; DialogButtons.OK,&#10;                1 =&gt; DialogButtons.OKCancel,&#10;                2 =&gt; DialogButtons.AbortRetryIgnore,&#10;                3 =&gt; DialogButtons.YesNoCancel,&#10;                4 =&gt; DialogButtons.YesNo,&#10;                5 =&gt; DialogButtons.RetryCancel,&#10;                6 =&gt; DialogButtons.CancelTryContinue,&#10;                _ =&gt; DialogButtons.OK&#10;            };&#10;&#10;            string buttonName = ViewModel.SelectedButtonIndex switch&#10;            {&#10;                0 =&gt; &quot;OK&quot;,&#10;                1 =&gt; &quot;OK/Cancel&quot;,&#10;                2 =&gt; &quot;Abort/Retry/Ignore&quot;,&#10;                3 =&gt; &quot;Yes/No/Cancel&quot;,&#10;                4 =&gt; &quot;Yes/No&quot;,&#10;                5 =&gt; &quot;Retry/Cancel&quot;,&#10;                6 =&gt; &quot;Cancel/Try/Continue&quot;,&#10;                _ =&gt; &quot;OK&quot;&#10;            };&#10;&#10;            var result = await App.Services.GetRequiredService&lt;IDialogService&gt;().ShowAsync(XamlRoot, $&quot;This MessageBox has {buttonName} button(s).&quot;, $&quot;{buttonName} Button(s)&quot;, buttonType);&#10;            ViewModel.DifferentButtonsResult = $&quot;Result: {result}&quot;;&#10;        }">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <Button AutomationProperties.AutomationId="MessageBox with Different Buttons"
                                Content="Show MessageBox"
                                AutomationProperties.Name="MessageBox with Different Buttons"
                                Click="ShowButtonFromComboBox_Click"
                                Margin="0,0,0,10" />
                            <TextBlock
                                AutomationProperties.AutomationId="DialogButtonsResult"
                                Text="{x:Bind ViewModel.DifferentButtonsResult, Mode=OneWay}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="10,0,0,0">
                            <TextBlock Text="Button Type:" Margin="0,0,0,5" />
                            <ComboBox AutomationProperties.AutomationId="ButtonTypeComboBox"
                                x:Name="ButtonTypeComboBox"
                                AutomationProperties.Name="MessageBox Button Selector"
                                SelectedIndex="{x:Bind ViewModel.SelectedButtonIndex, Mode=TwoWay}"
                                MinWidth="150">
                                <ComboBoxItem Content="OK" />
                                <ComboBoxItem Content="OK/Cancel" />
                                <ComboBoxItem Content="Abort/Retry/Ignore" />
                                <ComboBoxItem Content="Yes/No/Cancel" />
                                <ComboBoxItem Content="Yes/No" />
                                <ComboBoxItem Content="Retry/Cancel" />
                                <ComboBoxItem Content="Cancel/Try/Continue" />
                            </ComboBox>
                        </StackPanel>
                    </Grid>
                </controls:ControlExample>

                <controls:ControlExample
                    Margin="10,32,10,10"
                    HeaderText="MessageBox with Different Images"
                    XamlCode="&lt;Grid&gt;&#10;    &lt;Grid.ColumnDefinitions&gt;&#10;        &lt;ColumnDefinition Width=&quot;*&quot; /&gt;&#10;        &lt;ColumnDefinition Width=&quot;Auto&quot; /&gt;&#10;    &lt;/Grid.ColumnDefinitions&gt;&#10;    &lt;StackPanel Grid.Column=&quot;0&quot;&gt;&#10;        &lt;Button AutomationProperties.AutomationId=&quot;MessageBox with different images&quot; &#10;            Content=&quot;Show MessageBox&quot; &#10;            AutomationProperties.Name=&quot;MessageBox with different images&quot;&#10;            Click=&quot;ShowImageFromComboBox_Click&quot;&#10;            Margin=&quot;0,0,0,10&quot; /&gt;&#10;        &lt;TextBlock &#10;            Text=&quot;{x:Bind ViewModel.DifferentImagesResult, Mode=OneWay}&quot;&#10;            TextWrapping=&quot;Wrap&quot; /&gt;&#10;    &lt;/StackPanel&gt;&#10;    &lt;StackPanel Grid.Column=&quot;1&quot; Margin=&quot;10,0,0,0&quot;&gt;&#10;        &lt;TextBlock Text=&quot;Icon Type:&quot; Margin=&quot;0,0,0,5&quot; /&gt;&#10;        &lt;ComboBox AutomationProperties.AutomationId=&quot;ImageTypeComboBox&quot; &#10;            x:Name=&quot;ImageTypeComboBox&quot;&#10;            AutomationProperties.Name=&quot;MessageBox Image Selector&quot;&#10;            SelectedIndex=&quot;{x:Bind ViewModel.SelectedImageIndex, Mode=TwoWay}&quot;&#10;            MinWidth=&quot;150&quot;&gt;&#10;            &lt;ComboBoxItem Content=&quot;None&quot; /&gt;&#10;            &lt;ComboBoxItem Content=&quot;Error&quot; /&gt;&#10;            &lt;ComboBoxItem Content=&quot;Question&quot; /&gt;&#10;            &lt;ComboBoxItem Content=&quot;Warning&quot; /&gt;&#10;            &lt;ComboBoxItem Content=&quot;Information&quot; /&gt;&#10;        &lt;/ComboBox&gt;&#10;    &lt;/StackPanel&gt;&#10;&lt;/Grid&gt;"
                    CSharpCode="private async void ShowImageFromComboBox_Click(object sender, RoutedEventArgs e)&#10;        {&#10;            DialogImage imageType = ViewModel.SelectedImageIndex switch&#10;            {&#10;                0 =&gt; DialogImage.None,&#10;                1 =&gt; DialogImage.Error,&#10;                2 =&gt; DialogImage.Question,&#10;                3 =&gt; DialogImage.Warning,&#10;                4 =&gt; DialogImage.Information,&#10;                _ =&gt; DialogImage.None&#10;            };&#10;&#10;            string imageName = ViewModel.SelectedImageIndex switch&#10;            {&#10;                0 =&gt; &quot;None&quot;,&#10;                1 =&gt; &quot;Error&quot;,&#10;                2 =&gt; &quot;Question&quot;,&#10;                3 =&gt; &quot;Warning&quot;,&#10;                4 =&gt; &quot;Information&quot;,&#10;                _ =&gt; &quot;None&quot;&#10;            };&#10;&#10;            var result = await App.Services.GetRequiredService&lt;IDialogService&gt;().ShowAsync(XamlRoot, $&quot;This MessageBox displays the {imageName} icon.&quot;, $&quot;{imageName} Icon&quot;, DialogButtons.OK, imageType);&#10;            ViewModel.DifferentImagesResult = $&quot;Result: {result}&quot;;&#10;        }">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <Button AutomationProperties.AutomationId="MessageBox with different images"
                                Content="Show MessageBox"
                                AutomationProperties.Name="MessageBox with different images"
                                Click="ShowImageFromComboBox_Click"
                                Margin="0,0,0,10" />
                            <TextBlock
                                Text="{x:Bind ViewModel.DifferentImagesResult, Mode=OneWay}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="10,0,0,0">
                            <TextBlock Text="Icon Type:" Margin="0,0,0,5" />
                            <ComboBox AutomationProperties.AutomationId="ImageTypeComboBox"
                                x:Name="ImageTypeComboBox"
                                AutomationProperties.Name="MessageBox Image Selector"
                                SelectedIndex="{x:Bind ViewModel.SelectedImageIndex, Mode=TwoWay}"
                                MinWidth="150">
                                <ComboBoxItem Content="None" />
                                <ComboBoxItem Content="Error" />
                                <ComboBoxItem Content="Question" />
                                <ComboBoxItem Content="Warning" />
                                <ComboBoxItem Content="Information" />
                            </ComboBox>
                        </StackPanel>
                    </Grid>
                </controls:ControlExample>

                <controls:ControlExample
                    Margin="10,32,10,10"
                    HeaderText="Information, Error, and Warning MessageBox"
                    XamlCode="&lt;StackPanel&gt;&#10;    &lt;toolkit:WrapPanel Margin=&quot;0,0,0,10&quot;&gt;&#10;        &lt;Button AutomationProperties.AutomationId=&quot;ShowCommonInformation_Click&quot; Content=&quot;Information&quot; Click=&quot;ShowCommonInformation_Click&quot; Margin=&quot;0,0,5,0&quot; /&gt;&#10;        &lt;Button AutomationProperties.AutomationId=&quot;ShowCommonError_Click&quot; Content=&quot;Error&quot; Click=&quot;ShowCommonError_Click&quot; Margin=&quot;0,0,5,0&quot; /&gt;&#10;        &lt;Button AutomationProperties.AutomationId=&quot;ShowCommonWarning_Click&quot; Content=&quot;Warning&quot; Click=&quot;ShowCommonWarning_Click&quot; /&gt;&#10;    &lt;/toolkit:WrapPanel&gt;&#10;    &lt;TextBlock &#10;        Text=&quot;{x:Bind ViewModel.CommonMessagesResult, Mode=OneWay}&quot;&#10;        TextWrapping=&quot;Wrap&quot; /&gt;&#10;&lt;/StackPanel&gt;"
                    CSharpCode="private async void ShowCommonInformation_Click(object sender, RoutedEventArgs e)&#10;        {&#10;            var result = await App.Services.GetRequiredService&lt;IDialogService&gt;().ShowAsync(XamlRoot, &quot;The operation completed successfully.&quot;, &quot;Information&quot;, DialogButtons.OK, DialogImage.Information);&#10;            ViewModel.CommonMessagesResult = $&quot;Type: Information | Result: {result}&quot;;&#10;        }&#10;&#10;private async void ShowCommonError_Click(object sender, RoutedEventArgs e)&#10;        {&#10;            var result = await App.Services.GetRequiredService&lt;IDialogService&gt;().ShowAsync(XamlRoot, &quot;An error occurred! The operation could not be completed.&quot;, &quot;Error&quot;, DialogButtons.OK, DialogImage.Error);&#10;            ViewModel.CommonMessagesResult = $&quot;Type: Error | Result: {result}&quot;;&#10;        }&#10;&#10;private async void ShowCommonWarning_Click(object sender, RoutedEventArgs e)&#10;        {&#10;            var result = await App.Services.GetRequiredService&lt;IDialogService&gt;().ShowAsync(XamlRoot, &quot;This action cannot be undone! Do you want to continue?&quot;, &quot;Warning&quot;, DialogButtons.OKCancel, DialogImage.Warning);&#10;            ViewModel.CommonMessagesResult = $&quot;Type: Warning | Result: {result}&quot;;&#10;        }">
                    <StackPanel>
                        <toolkit:WrapPanel Margin="0,0,0,10">
                            <Button AutomationProperties.AutomationId="ShowCommonInformation_Click" Content="Information" Click="ShowCommonInformation_Click" Margin="0,0,5,0" />
                            <Button AutomationProperties.AutomationId="ShowCommonError_Click" Content="Error" Click="ShowCommonError_Click" Margin="0,0,5,0" />
                            <Button AutomationProperties.AutomationId="ShowCommonWarning_Click" Content="Warning" Click="ShowCommonWarning_Click" />
                        </toolkit:WrapPanel>
                        <TextBlock
                            Text="{x:Bind ViewModel.CommonMessagesResult, Mode=OneWay}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </controls:ControlExample>

                <controls:ControlExample
                    Margin="10,32,10,10"
                    HeaderText="MessageBox with Custom Default Button"
                    AutomationProperties.Name="View Source Code for MessageBox with a custom default"
                    XamlCode="&lt;StackPanel&gt;&#10;    &lt;Button AutomationProperties.AutomationId=&quot;ShowCustomDefaultButton_Click&quot; &#10;        Content=&quot;Show with 'No' as default&quot; &#10;        Click=&quot;ShowCustomDefaultButton_Click&quot;&#10;        Margin=&quot;0,0,0,10&quot; /&gt;&#10;    &lt;TextBlock &#10;        Text=&quot;{x:Bind ViewModel.CustomDefaultResult, Mode=OneWay}&quot;&#10;        TextWrapping=&quot;Wrap&quot; /&gt;&#10;&lt;/StackPanel&gt;"
                    CSharpCode="private async void ShowCustomDefaultButton_Click(object sender, RoutedEventArgs e)&#10;        {&#10;            var result = await App.Services.GetRequiredService&lt;IDialogService&gt;().ShowAsync(XamlRoot, &quot;Do you want to save changes? Press Enter to select the default 'No' button.&quot;, &quot;Save Changes&quot;, DialogButtons.YesNoCancel, DialogImage.Question, DialogResult.No);&#10;            ViewModel.CustomDefaultResult = $&quot;User selected: {result}&quot;;&#10;        }">
                    <StackPanel>
                        <Button AutomationProperties.AutomationId="ShowCustomDefaultButton_Click"
                            Content="Show with 'No' as default"
                            Click="ShowCustomDefaultButton_Click"
                            Margin="0,0,0,10" />
                        <TextBlock
                            Text="{x:Bind ViewModel.CustomDefaultResult, Mode=OneWay}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </controls:ControlExample>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
