<Page
    x:Class="WPFGallery.Views.FileAndFolderDialogsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:WPFGallery.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:WPFGallery.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    Foreground="{ThemeResource TextFillColorPrimaryBrush}"
    mc:Ignorable="d">

    <Grid x:Name="ContentPagePane">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <controls:PageHeader Margin="0,0,0,32" Title="{x:Bind ViewModel.PageTitle, Mode=OneWay}" ShowDescription="False" />

        <ScrollViewer Grid.Row="1" Margin="0,0,0,24" Padding="0,0,24,0">
            <StackPanel>
                <controls:ControlExample
                    Margin="10"
                    HeaderText="Pick Single File"
                    XamlCode="&lt;StackPanel&gt;&#10;    &lt;Button AutomationProperties.AutomationId=&quot;PickSingleFileButton_Click&quot; &#10;        Content=&quot;Pick a single file&quot; &#10;        Click=&quot;PickSingleFileButton_Click&quot;&#10;        Margin=&quot;0,0,0,10&quot; /&gt;&#10;    &lt;TextBlock &#10;        Text=&quot;{x:Bind ViewModel.SingleFilePath, Mode=OneWay}&quot;&#10;        TextWrapping=&quot;Wrap&quot; /&gt;&#10;&lt;/StackPanel&gt;"
                    CSharpCode="private async void PickSingleFileButton_Click(object sender, RoutedEventArgs args)&#10;    {&#10;        if (await _pickers.OpenFileAsync() is { } path) ViewModel.SingleFilePath = path;&#10;    }">
                    <StackPanel>
                        <Button AutomationProperties.AutomationId="PickSingleFileButton_Click"
                            Content="Pick a single file"
                            Click="PickSingleFileButton_Click"
                            Margin="0,0,0,10" />
                        <TextBlock
                            Text="{x:Bind ViewModel.SingleFilePath, Mode=OneWay}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </controls:ControlExample>

                <controls:ControlExample
                    Margin="10,32,10,10"
                    HeaderText="Pick Multiple Files"
                    XamlCode="&lt;StackPanel&gt;&#10;    &lt;Button AutomationProperties.AutomationId=&quot;PickMultipleFilesButton_Click&quot; &#10;        Content=&quot;Pick multiple files&quot; &#10;        Click=&quot;PickMultipleFilesButton_Click&quot;&#10;        Margin=&quot;0,0,0,10&quot; /&gt;&#10;    &lt;TextBlock &#10;        Text=&quot;{x:Bind ViewModel.MultipleFilesPath, Mode=OneWay}&quot;&#10;        TextWrapping=&quot;Wrap&quot; /&gt;&#10;&lt;/StackPanel&gt;"
                    CSharpCode="private async void PickMultipleFilesButton_Click(object sender, RoutedEventArgs args)&#10;    {&#10;        var paths = await _pickers.OpenFilesAsync();&#10;        if (paths.Count &gt; 0)&#10;            ViewModel.MultipleFilesPath = $&quot;Selected {paths.Count} file(s): {string.Join(&quot;, &quot;, paths)}&quot;;&#10;    }">
                    <StackPanel>
                        <Button AutomationProperties.AutomationId="PickMultipleFilesButton_Click"
                            Content="Pick multiple files"
                            Click="PickMultipleFilesButton_Click"
                            Margin="0,0,0,10" />
                        <TextBlock
                            Text="{x:Bind ViewModel.MultipleFilesPath, Mode=OneWay}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </controls:ControlExample>

                <controls:ControlExample
                    Margin="10,32,10,10"
                    HeaderText="Save File"
                    XamlCode="&lt;StackPanel&gt;&#10;    &lt;TextBox AutomationProperties.AutomationId=&quot;Save File Text Box&quot; &#10;        Text=&quot;{x:Bind ViewModel.FileContent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}&quot;&#10;        AcceptsReturn=&quot;True&quot;&#10;        TextWrapping=&quot;Wrap&quot;&#10;        MinHeight=&quot;80&quot;&#10;        Margin=&quot;0,0,0,10&quot;&#10;        ScrollViewer.VerticalScrollBarVisibility=&quot;Auto&quot;&#10;        AutomationProperties.Name=&quot;Save File Text Box&quot;&#10;        AutomationProperties.HelpText=&quot;The text in the textbox will be saved to a file on button click&quot;/&gt;&#10;    &lt;Button AutomationProperties.AutomationId=&quot;SaveFileButton_Click&quot; &#10;        Content=&quot;Save a file&quot; &#10;        Click=&quot;SaveFileButton_Click&quot;&#10;        Margin=&quot;0,0,0,10&quot; /&gt;&#10;    &lt;TextBlock &#10;        AutomationProperties.AutomationId=&quot;SavedFileStatus&quot;&#10;        Text=&quot;{x:Bind ViewModel.SavedFilePath, Mode=OneWay}&quot;&#10;        TextWrapping=&quot;Wrap&quot; /&gt;&#10;&lt;/StackPanel&gt;"
                    CSharpCode="private async void SaveFileButton_Click(object sender, RoutedEventArgs args)&#10;    {&#10;        try&#10;        {&#10;            if (await _pickers.SaveFileAsync(ViewModel.FileContent) is { } path)&#10;                ViewModel.SavedFilePath = $&quot;File saved successfully: {path}&quot;;&#10;        }&#10;        catch (Exception ex)&#10;        {&#10;            ViewModel.SavedFilePath = $&quot;Error saving file: {ex.Message}&quot;;&#10;        }&#10;    }">
                    <StackPanel>
                        <TextBox AutomationProperties.AutomationId="Save File Text Box"
                            Text="{x:Bind ViewModel.FileContent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            AcceptsReturn="True"
                            TextWrapping="Wrap"
                            MinHeight="80"
                            Margin="0,0,0,10"
                            ScrollViewer.VerticalScrollBarVisibility="Auto"
                            AutomationProperties.Name="Save File Text Box"
                            AutomationProperties.HelpText="The text in the textbox will be saved to a file on button click"/>
                        <Button AutomationProperties.AutomationId="SaveFileButton_Click"
                            Content="Save a file"
                            Click="SaveFileButton_Click"
                            Margin="0,0,0,10" />
                        <TextBlock
                            AutomationProperties.AutomationId="SavedFileStatus"
                            Text="{x:Bind ViewModel.SavedFilePath, Mode=OneWay}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </controls:ControlExample>

                <controls:ControlExample
                    Margin="10,32,10,10"
                    HeaderText="Pick Folder"
                    XamlCode="&lt;StackPanel&gt;&#10;    &lt;Button AutomationProperties.AutomationId=&quot;PickFolderButton_Click&quot; &#10;        Content=&quot;Pick a folder&quot; &#10;        Click=&quot;PickFolderButton_Click&quot;&#10;        Margin=&quot;0,0,0,10&quot; /&gt;&#10;    &lt;TextBlock &#10;        Text=&quot;{x:Bind ViewModel.SelectedFolderPath, Mode=OneWay}&quot;&#10;        TextWrapping=&quot;Wrap&quot; /&gt;&#10;&lt;/StackPanel&gt;"
                    CSharpCode="private async void PickFolderButton_Click(object sender, RoutedEventArgs args)&#10;    {&#10;        if (await _pickers.OpenFolderAsync() is { } path) ViewModel.SelectedFolderPath = path;&#10;    }">
                    <StackPanel>
                        <Button AutomationProperties.AutomationId="PickFolderButton_Click"
                            Content="Pick a folder"
                            Click="PickFolderButton_Click"
                            Margin="0,0,0,10" />
                        <TextBlock
                            Text="{x:Bind ViewModel.SelectedFolderPath, Mode=OneWay}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </controls:ControlExample>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
