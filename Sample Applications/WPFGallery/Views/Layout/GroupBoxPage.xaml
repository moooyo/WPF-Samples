<Page x:Class="WPFGallery.Views.GroupBoxPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="using:WPFGallery.Views"
      xmlns:controls="using:WPFGallery.Controls"
      mc:Ignorable="d"
      d:DesignHeight="450" d:DesignWidth="800"
      Foreground="{ThemeResource TextFillColorPrimaryBrush}">

    <Grid>
        <Grid x:Name="ContentPagePane">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <controls:PageHeader Margin="0,0,0,32" Title="{x:Bind ViewModel.PageTitle, Mode=OneWay}" ShowDescription="False" />
            <ScrollViewer Grid.Row="1" Margin="0,0,0,24" Padding="0,0,24,0">
                <StackPanel Margin="0,0,0,24">
                    <controls:ControlExample
                        Margin="10"
                        HeaderText="A GroupBox"
                    XamlCode="&lt;Border&#10;  BorderBrush=&quot;{ThemeResource CardStrokeColorDefaultBrush}&quot; BorderThickness=&quot;1&quot; Padding=&quot;16&quot; CornerRadius=&quot;8&quot;&#10;  HorizontalAlignment=&quot;Left&quot; &#10;  VerticalAlignment=&quot;Center&quot; &#10;  MaxWidth=&quot;400&quot;&gt;&#10;    &lt;StackPanel&gt;&#10;        &lt;TextBlock Text=&quot;User Information&quot; FontWeight=&quot;SemiBold&quot; Margin=&quot;0,0,0,16&quot;&#10;                   AutomationProperties.HeadingLevel=&quot;Level2&quot; /&gt;&#10;        &lt;StackPanel Orientation=&quot;Horizontal&quot;&gt;&#10;            &lt;TextBlock Width=&quot;100&quot; Text=&quot;Name:&quot; /&gt;&#10;            &lt;TextBox AutomationProperties.AutomationId=&quot;NameTextBox&quot; Name=&quot;NameTextBox&quot; Width=&quot;280&quot; Margin=&quot;10,0,0,20&quot; AutomationProperties.Name=&quot;Name Field&quot;/&gt;&#10;        &lt;/StackPanel&gt;&#10;&#10;        &lt;StackPanel Orientation=&quot;Horizontal&quot;&gt;&#10;            &lt;TextBlock Width=&quot;100&quot; Text=&quot;Gender:&quot; Margin=&quot;0,10,0,0&quot;/&gt;&#10;            &lt;TextBox AutomationProperties.AutomationId=&quot;GenderTextBox&quot; Name=&quot;GenderTextBox&quot; Width=&quot;280&quot; Margin=&quot;10,0,0,20&quot; AutomationProperties.Name=&quot;Gender Field&quot;/&gt;&#10;        &lt;/StackPanel&gt;&#10;        &lt;Button Content=&quot;Submit&quot; HorizontalAlignment=&quot;Right&quot; Margin=&quot;0,10,0,0&quot; /&gt;&#10;    &lt;/StackPanel&gt;&#10;&lt;/Border&gt;">
                        <Border
                          BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" Padding="16" CornerRadius="8"
                          HorizontalAlignment="Left"
                          VerticalAlignment="Center"
                          MaxWidth="400">
                            <StackPanel>
                                <TextBlock Text="User Information" FontWeight="SemiBold" Margin="0,0,0,16"
                                           AutomationProperties.HeadingLevel="Level2" />
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Width="100" Text="Name:" />
                                    <TextBox AutomationProperties.AutomationId="NameTextBox" Name="NameTextBox" Width="280" Margin="10,0,0,20" AutomationProperties.Name="Name Field"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Width="100" Text="Gender:" Margin="0,10,0,0"/>
                                    <TextBox AutomationProperties.AutomationId="GenderTextBox" Name="GenderTextBox" Width="280" Margin="10,0,0,20" AutomationProperties.Name="Gender Field"/>
                                </StackPanel>
                                <Button Content="Submit" HorizontalAlignment="Right" Margin="0,10,0,0" />
                            </StackPanel>
                        </Border>
                    </controls:ControlExample>
                </StackPanel>
            </ScrollViewer>
        </Grid>

    </Grid>
</Page>
