<Page
    x:Class="WPFGallery.Views.StackPanelPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:WPFGallery.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:WPFGallery.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    Foreground="{ThemeResource TextFillColorPrimaryBrush}"
    mc:Ignorable="d">

    <Grid x:Name="ContentPagePane">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <controls:PageHeader Margin="0,0,0,32" Title="{x:Bind ViewModel.PageTitle, Mode=OneWay}" ShowDescription="False" />

        <ScrollViewer Grid.Row="1" Margin="0,0,0,24" Padding="0,0,24,0">
            <StackPanel Margin="0,0,0,24">
                <controls:ControlExample
                    Margin="10"
                    HeaderText="A basic vertical StackPanel"
                    XamlCode="&lt;StackPanel Orientation=&quot;Vertical&quot;&gt;&#10;    &lt;Rectangle Width=&quot;100&quot; Height=&quot;30&quot; Fill=&quot;CornflowerBlue&quot; Margin=&quot;5&quot; /&gt;&#10;    &lt;Rectangle Width=&quot;100&quot; Height=&quot;30&quot; Fill=&quot;LightCoral&quot; Margin=&quot;5&quot; /&gt;&#10;    &lt;Rectangle Width=&quot;100&quot; Height=&quot;30&quot; Fill=&quot;MediumSeaGreen&quot; Margin=&quot;5&quot; /&gt;&#10;&lt;/StackPanel&gt;">
                    <StackPanel Orientation="Vertical">
                        <Rectangle Width="100" Height="30" Fill="CornflowerBlue" Margin="5" />
                        <Rectangle Width="100" Height="30" Fill="LightCoral" Margin="5" />
                        <Rectangle Width="100" Height="30" Fill="MediumSeaGreen" Margin="5" />
                    </StackPanel>
                </controls:ControlExample>

                <controls:ControlExample
                    Margin="10"
                    HeaderText="A horizontal StackPanel"
                    XamlCode="&lt;StackPanel Orientation=&quot;Horizontal&quot;&gt;&#10;    &lt;Rectangle Width=&quot;100&quot; Height=&quot;30&quot; Fill=&quot;CornflowerBlue&quot; Margin=&quot;5&quot; /&gt;&#10;    &lt;Rectangle Width=&quot;100&quot; Height=&quot;30&quot; Fill=&quot;LightCoral&quot; Margin=&quot;5&quot; /&gt;&#10;    &lt;Rectangle Width=&quot;100&quot; Height=&quot;30&quot; Fill=&quot;MediumSeaGreen&quot; Margin=&quot;5&quot; /&gt;&#10;&lt;/StackPanel&gt;">
                    <StackPanel Orientation="Horizontal">
                        <Rectangle Width="100" Height="30" Fill="CornflowerBlue" Margin="5" />
                        <Rectangle Width="100" Height="30" Fill="LightCoral" Margin="5" />
                        <Rectangle Width="100" Height="30" Fill="MediumSeaGreen" Margin="5" />
                    </StackPanel>
                </controls:ControlExample>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
