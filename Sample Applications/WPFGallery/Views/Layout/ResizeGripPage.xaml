<Page x:Class="WPFGallery.Views.ResizeGripPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="using:WPFGallery.Views"
      xmlns:controls="using:WPFGallery.Controls"
      mc:Ignorable="d"
      d:DesignHeight="450" d:DesignWidth="800"
      Foreground="{ThemeResource TextFillColorPrimaryBrush}">

    <Page.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </Page.Resources>

    <Grid>
        <Grid x:Name="ContentPagePane">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <controls:PageHeader Margin="0,0,0,32" Title="{x:Bind ViewModel.PageTitle, Mode=OneWay}" ShowDescription="False" />
            <ScrollViewer Grid.Row="1" Margin="0,0,0,24" Padding="0,0,24,0">
                <StackPanel Margin="0,0,0,24">
                    <controls:ControlExample
                        Margin="10"
                        HeaderText="A ResizeGrip"
                    XamlCode="&lt;StackPanel Orientation=&quot;Vertical&quot; Grid.Row=&quot;1&quot;&gt;&#10;    &lt;TextBlock Margin=&quot;0 10 0 40&quot;&gt;&#10;        Resize grip control is only used along with a Window in WPF. &#10;        &lt;LineBreak/&gt;&#10;        It can not be used in other places as such. &#10;        To see the resize grip in action click the button.&#10;    &lt;/TextBlock&gt;&#10;    &lt;Button AutomationProperties.AutomationId=&quot;OpenResizeGripWindow&quot; &#10;        x:Name=&quot;OpenResizeGripWindow&quot;&#10;        VerticalAlignment=&quot;Center&quot;&#10;        HorizontalAlignment=&quot;Center&quot;&#10;        Content=&quot;Open window with resize grip&quot;&#10;        Click=&quot;OpenResizeGripWindow_Click&quot; /&gt;&#10;&lt;/StackPanel&gt;"
                    CSharpCode="private void OpenResizeGripWindow_Click(object sender, RoutedEventArgs e)&#10;        {&#10;            var window = new WinUIEx.WindowEx()&#10;            {&#10;                Width = 500,&#10;                Height = 300,&#10;                IsResizable = true,&#10;                Content = new TextBlock&#10;                {&#10;                    Text = &quot;Drag the window edges or corners to resize this WinUI window.&quot;,&#10;                    HorizontalAlignment = HorizontalAlignment.Center,&#10;                    VerticalAlignment = VerticalAlignment.Center,&#10;                    FontSize = 16&#10;                }&#10;            };&#10;            App.ShowSampleWindow(window);&#10;        }">
                        <StackPanel Orientation="Vertical" Grid.Row="1">
                            <TextBlock Margin="0 10 0 40">
                                Resize grip control is only used along with a Window in WPF.
                                <LineBreak/>
                                It can not be used in other places as such.
                                To see the resize grip in action click the button.
                            </TextBlock>
                            <Button AutomationProperties.AutomationId="OpenResizeGripWindow"
                                x:Name="OpenResizeGripWindow"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                Content="Open window with resize grip"
                                Click="OpenResizeGripWindow_Click" />
                        </StackPanel>
                    </controls:ControlExample>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
