<Page
    x:Class="WPFGallery.Views.LabelPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:WPFGallery.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:WPFGallery.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    Foreground="{ThemeResource TextFillColorPrimaryBrush}"
    mc:Ignorable="d">

    <Grid x:Name="ContentPagePane">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <controls:PageHeader Margin="0,0,0,32" Title="{x:Bind ViewModel.PageTitle, Mode=OneWay}" Description="{x:Bind ViewModel.PageDescription, Mode=OneWay}" />

        <ScrollViewer Grid.Row="1" Margin="0,0,0,24" Padding="0,0,24,0">
            <StackPanel Margin="0,0,0,24">
                <controls:ControlExample
                    Margin="10"
                    HeaderText="A simple Label."
                    XamlCode="&lt;ContentControl Content=&quot;I am a Label.&quot; Foreground=&quot;{ThemeResource TextFillColorPrimaryBrush}&quot; Opacity=&quot;{ThemeResource DeemphasizedTextOpacity}&quot; /&gt;">
                    <ContentControl Content="I am a Label." Foreground="{ThemeResource TextFillColorPrimaryBrush}" Opacity="{ThemeResource DeemphasizedTextOpacity}" />
                </controls:ControlExample>

                <controls:ControlExample
                    Margin="10,36,10,10"
                    HeaderText="A Label for TextBox."
                    XamlCode="&lt;Grid&gt;&#10;    &lt;Grid.RowDefinitions&gt;&#10;        &lt;RowDefinition Height=&quot;Auto&quot; /&gt;&#10;        &lt;RowDefinition Height=&quot;Auto&quot; /&gt;&#10;    &lt;/Grid.RowDefinitions&gt;&#10;    &lt;ContentControl Grid.Row=&quot;0&quot; Content=&quot;I am a Label of the TextBox below.&quot; Foreground=&quot;{ThemeResource TextFillColorPrimaryBrush}&quot; Opacity=&quot;{ThemeResource DeemphasizedTextOpacity}&quot; /&gt;&#10;    &#10;    &lt;TextBox AutomationProperties.AutomationId=&quot;Simple Text Box&quot; Grid.Row=&quot;1&quot; AutomationProperties.Name=&quot;Simple Text Box&quot; /&gt;&#10;&lt;/Grid&gt;">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <ContentControl Grid.Row="0" Content="I am a Label of the TextBox below." Foreground="{ThemeResource TextFillColorPrimaryBrush}" Opacity="{ThemeResource DeemphasizedTextOpacity}" />
                        <!--  Target="{Binding ElementName=TextBoxForLabel}"  -->
                        <TextBox AutomationProperties.AutomationId="Simple Text Box" Grid.Row="1" AutomationProperties.Name="Simple Text Box" />
                    </Grid>
                </controls:ControlExample>
            </StackPanel>

        </ScrollViewer>
    </Grid>

</Page>
