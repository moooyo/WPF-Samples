<Page
    x:Class="WPFGallery.Views.TextBoxPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:WPFGallery.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:WPFGallery.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:helpers="using:WPFGallery.Helpers"
    d:DesignHeight="450"
    d:DesignWidth="800"
    Foreground="{ThemeResource TextFillColorPrimaryBrush}"
    mc:Ignorable="d">

    <Grid x:Name="ContentPagePane">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <controls:PageHeader Margin="0,0,0,32" Title="{x:Bind ViewModel.PageTitle, Mode=OneWay}" Description="{x:Bind ViewModel.PageDescription, Mode=OneWay}" />

        <ScrollViewer Grid.Row="1" Margin="0,0,0,24" Padding="0,0,24,0">
            <StackPanel Margin="0,0,0,24">
                <controls:ControlExample Margin="10" HeaderText="A simple TextBox."
                    XamlCode="&lt;TextBox AutomationProperties.AutomationId=&quot;simple TextBox&quot; AutomationProperties.Name=&quot;simple TextBox&quot; /&gt;">
                    <TextBox AutomationProperties.AutomationId="simple TextBox" AutomationProperties.Name="simple TextBox" />
                </controls:ControlExample>

                <controls:ControlExample Margin="10,36,10,10"
                                         HeaderText="A TextBox with input validation."
                    XamlCode="&lt;StackPanel Spacing=&quot;8&quot;&gt;&#10;    &lt;TextBox AutomationProperties.AutomationId=&quot;ValidatedTextBox&quot; x:Name=&quot;ValidatedTextBox&quot; AutomationProperties.Name=&quot;validated TextBox&quot;&#10;             Text=&quot;{x:Bind ViewModel.InputText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}&quot; /&gt;&#10;    &lt;TextBlock Text=&quot;{x:Bind ViewModel.ValidationError, Mode=OneWay}&quot;&#10;               AutomationProperties.AutomationId=&quot;TextValidationError&quot;&#10;               Foreground=&quot;{ThemeResource SystemFillColorCriticalBrush}&quot;&#10;               AutomationProperties.LiveSetting=&quot;Polite&quot; TextWrapping=&quot;Wrap&quot; /&gt;&#10;&lt;/StackPanel&gt;">
                    <StackPanel Spacing="8">
                        <TextBox AutomationProperties.AutomationId="ValidatedTextBox" x:Name="ValidatedTextBox" AutomationProperties.Name="validated TextBox"
                                 Text="{x:Bind ViewModel.InputText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="{x:Bind ViewModel.ValidationError, Mode=OneWay}"
                                   AutomationProperties.AutomationId="TextValidationError"
                                   Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                   AutomationProperties.LiveSetting="Polite" TextWrapping="Wrap" />
                    </StackPanel>
                </controls:ControlExample>

                <controls:ControlExample
                    Margin="10,36,10,10"
                    HeaderText="A multi-line TextBox."
                    XamlCode="&lt;TextBox AutomationProperties.AutomationId=&quot;multi-line TextBox&quot;&#10;    AcceptsReturn=&quot;True&quot;&#10;    AutomationProperties.Name=&quot;multi-line TextBox&quot;&#10;    TextWrapping=&quot;Wrap&quot; /&gt;">
                    <TextBox AutomationProperties.AutomationId="multi-line TextBox"
                        AcceptsReturn="True"
                        AutomationProperties.Name="multi-line TextBox"
                        TextWrapping="Wrap" />
                </controls:ControlExample>
            </StackPanel>

        </ScrollViewer>
    </Grid>

</Page>
