<Page
    x:Class="WPFGallery.Views.UserDashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:helpers="using:WPFGallery.Helpers"
    xmlns:local="using:WPFGallery.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:WPFGallery.Models"
    d:DesignHeight="450"
    d:DesignWidth="800"
    d:DataContext="{d:DesignInstance Type=local:UserDashboardPage}"
    Foreground="{ThemeResource TextFillColorPrimaryBrush}"
    mc:Ignorable="d"
    SizeChanged="Page_SizeChanged">
    <Page.Resources>
        <helpers:ImageIdToBrushConverter x:Key="ImageIdToBrushConverter" />
        <helpers:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
        <helpers:EmptyToVisibilityConverter x:Key="EmptyToVisibilityConverter" />

        <Style TargetType="ContentControl" x:Key="GenericLabelStyle">
            <Setter Property="Opacity" Value="{ThemeResource DeemphasizedTextOpacity}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}"/>
        </Style>

    </Page.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" MaxHeight="280"/>
            <RowDefinition Height="2*" />
        </Grid.RowDefinitions>

        <Grid x:Name="UserListGrid" Grid.Column="0" Grid.RowSpan="2" >
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <ListView AutomationProperties.AutomationId="UserList"
                x:Name="UserList"
                AutomationProperties.Name="Users"
                Grid.Row="0"
                Width="300"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                ItemsSource="{x:Bind ViewModel.Users, Mode=TwoWay}"
                SelectedItem="{x:Bind ViewModel.SelectedUser, Mode=TwoWay}"
                SelectionMode="Single">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:User">
                        <Grid Margin="8,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Ellipse
                                x:Name="Ellipse"
                                Grid.RowSpan="2"
                                Width="32"
                                Height="32"
                                Margin="6"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                                <Ellipse.Fill>
                                    <Binding Converter="{StaticResource ImageIdToBrushConverter}" Path="ImageKey" />
                                </Ellipse.Fill>
                            </Ellipse>
                            <TextBlock
                                Grid.Row="0"
                                Grid.Column="1"
                                Margin="12,6,0,0"
                                Text="{Binding Name, Mode=OneWay}"
                                AutomationProperties.HeadingLevel="Level3" />
                            <TextBlock
                                Grid.Row="1"
                                Grid.Column="1"
                                Margin="12,0,0,6"
                                Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                Opacity="{ThemeResource DeemphasizedTextOpacity}"
                                Text="{Binding Company, Mode=OneWay}" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <Button AutomationProperties.AutomationId="NewUserButton"
                x:Name="NewUserButton"
                Grid.Row="1"
                Margin="10"
                HorizontalAlignment="Center"
                Command="{x:Bind ViewModel.AddUserCommand, Mode=OneWay}"
                Content="Add New User"
                Style="{ThemeResource AccentButtonStyle}" />
        </Grid>

        <Grid x:Name="UserDetailsGrid" Grid.Column="1" Grid.RowSpan="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel
                x:Name="UserDetailHeader"
                Grid.Row="0"
                Margin="20,10,20,10"
                Orientation="Horizontal"
                Visibility="{Binding ViewModel.SelectedUser, Converter={StaticResource NullToVisibilityConverter}}">
                    <Ellipse
                      x:Name="UserAvatar"
                      Width="96"
                      Height="96"
                      Margin="12"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center">
                        <Ellipse.Fill>
                            <Binding Converter="{StaticResource ImageIdToBrushConverter}" Path="ViewModel.SelectedUser.ImageKey" />
                        </Ellipse.Fill>
                    </Ellipse>
                    <StackPanel x:Name="UserDetailHeaderPanel" Orientation="Vertical" VerticalAlignment="Center">
                        <TextBlock
                          x:Name="UserDetailHeaderNameBox"
                          FontSize="24" Text="{x:Bind ViewModel.SelectedUser.Name, Mode=OneWay}" />
                        <TextBlock
                          x:Name="UserDetailHeaderCompanyBox"
                          FontSize="16" Text="{x:Bind ViewModel.SelectedUser.Company, Mode=OneWay}" />
                    </StackPanel>
            </StackPanel>

            <Grid
                x:Name="UserDetailFormGrid"
                Grid.Row="1"
                Margin="20,10,20,10"
                Visibility="{Binding ViewModel.SelectedUser, Converter={StaticResource NullToVisibilityConverter}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <ScrollViewer Grid.Column="1" IsTabStop="False">
                    <StackPanel Margin="20,0,20,0" >
                        <Grid x:Name="NameInputGrid">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <StackPanel x:Name="FirstNamePanel"
                                Grid.Column="0" Margin="0,0,10,0" Orientation="Vertical">
                                <ContentControl Content="First Name" Style="{StaticResource GenericLabelStyle}" FontWeight="SemiBold" />
                                <TextBox AutomationProperties.AutomationId="FirstName" AutomationProperties.Name="First Name" Margin="0,5,0,15" Text="{x:Bind ViewModel.EditableUser.FirstName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{x:Bind ViewModel.IsReadOnly, Mode=OneWay}"/>
                            </StackPanel>
                            <StackPanel x:Name="LastNamePanel"
                                Grid.Column="1" Orientation="Vertical">
                                <ContentControl Content="Last Name" Style="{StaticResource GenericLabelStyle}" FontWeight="SemiBold" />
                                <TextBox AutomationProperties.AutomationId="LastName" AutomationProperties.Name="Last Name" Margin="0,5,0,15" Text="{x:Bind ViewModel.EditableUser.LastName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{x:Bind ViewModel.IsReadOnly, Mode=OneWay}"/>
                            </StackPanel>
                        </Grid>

                        <ContentControl Content="Company" Style="{StaticResource GenericLabelStyle}" FontWeight="SemiBold" />
                        <TextBox AutomationProperties.AutomationId="Company" AutomationProperties.Name="Company" Margin="0,5,0,15" Text="{x:Bind ViewModel.EditableUser.Company, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{x:Bind ViewModel.IsReadOnly, Mode=OneWay}"/>

                        <ContentControl Content="Address" Style="{StaticResource GenericLabelStyle}" FontWeight="SemiBold" />
                        <TextBox AutomationProperties.AutomationId="Address" AutomationProperties.Name="Address" Margin="0,5,0,15" Text="{x:Bind ViewModel.EditableUser.Address, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{x:Bind ViewModel.IsReadOnly, Mode=OneWay}"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ContentControl Style="{StaticResource GenericLabelStyle}" Content="Age" Grid.Column="0" FontWeight="SemiBold" />
                            <TextBlock x:Name="AgeIndicatorBox" Padding="10 0 0 0" Grid.Column="1" Text="{x:Bind ViewModel.EditableUser.Age, Mode=OneWay}" VerticalAlignment="Center" />
                        </Grid>
                        <Slider AutomationProperties.AutomationId="Age in years"
                            Margin="0,5,0,15"
                            AutomationProperties.Name="Age in years"
                            Maximum="62"
                            Minimum="21"
                            Value="{x:Bind ViewModel.EditableUser.Age, Mode=TwoWay}"
                            ValueChanged="AgeSlider_ValueChanged"
                            IsEnabled="{x:Bind ViewModel.IsEditing, Mode=OneWay}"/>

                        <ContentControl Content="Date of Joining" Style="{StaticResource GenericLabelStyle}" FontWeight="SemiBold" />
                        <CalendarDatePicker AutomationProperties.AutomationId="Date of Joining" AutomationProperties.Name="Date of Joining" Margin="0,5,0,15" Date="{x:Bind ViewModel.EditableUser.DateOfJoiningOffset, Mode=TwoWay}" IsEnabled="{x:Bind ViewModel.IsEditing, Mode=OneWay}"/>

                        <StackPanel Margin="0,5,0,15" Orientation="Horizontal">
                            <ContentControl Style="{StaticResource GenericLabelStyle}"
                                Margin="0,0,10,0"
                                VerticalAlignment="Center"
                                Content="Is user a new graduate ?"
                                FontWeight="SemiBold" />
                            <CheckBox AutomationProperties.AutomationId="Is user a new graduate ?" AutomationProperties.Name="Is user a new graduate ?" VerticalAlignment="Center" IsChecked="{x:Bind ViewModel.EditableUser.IsNewGraduate, Mode=TwoWay}" IsEnabled="{x:Bind ViewModel.IsEditing, Mode=OneWay}"/>
                        </StackPanel>

                        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                            <TextBlock FontSize="14" HorizontalAlignment="Left" VerticalAlignment="Center" Visibility="{Binding ViewModel.IsSaved, Converter={StaticResource BooleanToVisibilityConverter}}" FontStyle="Italic">
                                Saved!
                            </TextBlock>

                            <TextBlock FontSize="14" HorizontalAlignment="Left" VerticalAlignment="Center" Visibility="{Binding ViewModel.DeletedName, Converter={StaticResource EmptyToVisibilityConverter }}" FontStyle="Italic">
                                 <Run Text="User" />
                                 <Run Text="{x:Bind ViewModel.DeletedName, Mode=OneWay}" />
                                 <Run Text="Deleted!" />
                            </TextBlock>
                            <Button AutomationProperties.AutomationId="edit_button"
                                x:Name="edit_button"
                                Margin="10"
                                Visibility="{Binding ViewModel.IsReadOnly, Converter={StaticResource BooleanToVisibilityConverter}}"
                                Click="EditButton_Click"
                                Content="Edit" />
                            <Button AutomationProperties.AutomationId="delete_button"
                                x:Name="delete_button"
                                Margin="10"
                                Visibility="{Binding ViewModel.IsReadOnly, Converter={StaticResource BooleanToVisibilityConverter}}"
                                Click="DeleteButton_Click"
                                Content="Delete" />
                            <Button AutomationProperties.AutomationId="save_button"
                                x:Name="save_button"
                                Margin="10"
                                Visibility="{Binding ViewModel.IsEditing, Converter={StaticResource BooleanToVisibilityConverter}}"
                                Click="SaveButton_Click"
                                Content="Save"/>
                            <Button AutomationProperties.AutomationId="cancel_button"
                                x:Name="cancel_button"
                                Margin="10"
                                Visibility="{Binding ViewModel.IsEditing, Converter={StaticResource BooleanToVisibilityConverter}}"
                                Click="CancelButton_Click"
                                Content="Cancel" />

                      </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</Page>
