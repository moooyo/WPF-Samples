<Page
    x:Class="WPFGallery.Views.CanvasPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:WPFGallery.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:WPFGallery.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    Foreground="{ThemeResource TextFillColorPrimaryBrush}"
    mc:Ignorable="d">

    <Grid x:Name="ContentPagePane">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <controls:PageHeader Margin="0,0,0,32" Title="{x:Bind ViewModel.PageTitle, Mode=OneWay}" Description="{x:Bind ViewModel.PageDescription, Mode=OneWay}" />

        <ScrollViewer Grid.Row="1" Margin="0,0,0,24" Padding="0,0,24,0">
            <Grid Margin="0,0,0,24">
                <controls:ControlExample Margin="10" HeaderText="A basic Canvas inside the ViewBox"
                    XamlCode="&lt;Viewbox Width=&quot;200&quot; Height=&quot;200&quot;&gt;&#10;    &lt;Canvas Width=&quot;47&quot; Height=&quot;123&quot;&gt;&#10;        &lt;Path Data=&quot;M0,19H18V84h29v15H0V19Z&quot; Fill=&quot;{ThemeResource TextFillColorSecondaryBrush}&quot; /&gt;&#10;        &lt;Path Data=&quot;M46,80H29V15H0V0H46V80Z&quot; Fill=&quot;{ThemeResource TextFillColorSecondaryBrush}&quot; /&gt;&#10;    &lt;/Canvas&gt;&#10;&lt;/Viewbox&gt;">

                    <Viewbox Width="200" Height="200">
                        <Canvas Width="47" Height="123">
                            <Path Data="M0,19H18V84h29v15H0V19Z" Fill="{ThemeResource TextFillColorSecondaryBrush}" />
                            <Path Data="M46,80H29V15H0V0H46V80Z" Fill="{ThemeResource TextFillColorSecondaryBrush}" />
                        </Canvas>
                    </Viewbox>
                </controls:ControlExample>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>
