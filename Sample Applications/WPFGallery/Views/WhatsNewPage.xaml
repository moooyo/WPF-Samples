<Page x:Class="WPFGallery.Views.WhatsNewPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="using:WPFGallery.Controls"
      Foreground="{ThemeResource TextFillColorPrimaryBrush}">
    <Grid RowSpacing="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <controls:PageHeader Title="{x:Bind ViewModel.PageTitle, Mode=OneWay}"
                             Description="{x:Bind ViewModel.PageDescription, Mode=OneWay}" />
        <ScrollViewer Grid.Row="1" Padding="0,0,24,24">
            <StackPanel Spacing="16">
                <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Native WinUI controls" />
                <TextBlock TextWrapping="Wrap"
                           Text="The Gallery now uses Microsoft.UI.Xaml. NavigationView and Frame host the existing page catalog. CalendarView, CalendarDatePicker, TabView, RichEditBox, and MenuBar replace their WPF counterparts. Editable tables use ListView with typed Grid rows." />
                <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Theme-aware Fluent resources" />
                <TextBlock TextWrapping="Wrap"
                           Text="ThemeResource updates brushes when the app theme changes. Use semantic brushes rather than WPF SystemColors keys. Light, Dark, and system themes are available in Settings; Windows contrast themes remain system-controlled." />
                <controls:ControlExample HeaderText="Semantic accent brushes"
                    XamlCode="&lt;StackPanel Orientation=&quot;Horizontal&quot; Spacing=&quot;8&quot;&gt;&#10;    &lt;Border Width=&quot;80&quot; Height=&quot;50&quot; CornerRadius=&quot;4&quot;&#10;            Background=&quot;{ThemeResource AccentFillColorDefaultBrush}&quot; /&gt;&#10;    &lt;Border Width=&quot;80&quot; Height=&quot;50&quot; CornerRadius=&quot;4&quot;&#10;            Background=&quot;{ThemeResource AccentFillColorSecondaryBrush}&quot; /&gt;&#10;    &lt;Border Width=&quot;80&quot; Height=&quot;50&quot; CornerRadius=&quot;4&quot;&#10;            Background=&quot;{ThemeResource AccentFillColorTertiaryBrush}&quot; /&gt;&#10;&lt;/StackPanel&gt;">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Border Width="80" Height="50" CornerRadius="4"
                                Background="{ThemeResource AccentFillColorDefaultBrush}" />
                        <Border Width="80" Height="50" CornerRadius="4"
                                Background="{ThemeResource AccentFillColorSecondaryBrush}" />
                        <Border Width="80" Height="50" CornerRadius="4"
                                Background="{ThemeResource AccentFillColorTertiaryBrush}" />
                    </StackPanel>
                </controls:ControlExample>
                <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Asynchronous desktop services" />
                <TextBlock TextWrapping="Wrap"
                           Text="ContentDialog preserves the sample button combinations and default results. Desktop file pickers use the owning WindowId. Clipboard operations use Windows DataTransfer, including asynchronous image and text reads." />
                <HyperlinkButton AutomationProperties.AutomationId="NavigateToMessageBoxSample" Content="Explore dialog samples" Click="NavigateToMessageBoxSample" />
                <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Explicit WinUI layouts and bindings" />
                <TextBlock TextWrapping="Wrap"
                           Text="Define rows and columns with collection elements. Editable x:Bind expressions explicitly use TwoWay; TextBox bindings update the view model on each text change. Source code shown by the samples uses the migrated controls." />
                <controls:ControlExample HeaderText="Grid row and column definitions"
                    XamlCode="&lt;Grid ColumnSpacing=&quot;16&quot; RowSpacing=&quot;8&quot;&gt;&#10;    &lt;Grid.RowDefinitions&gt;&#10;        &lt;RowDefinition Height=&quot;Auto&quot; /&gt;&#10;        &lt;RowDefinition Height=&quot;Auto&quot; /&gt;&#10;    &lt;/Grid.RowDefinitions&gt;&#10;    &lt;Grid.ColumnDefinitions&gt;&#10;        &lt;ColumnDefinition Width=&quot;Auto&quot; /&gt;&#10;        &lt;ColumnDefinition Width=&quot;*&quot; /&gt;&#10;    &lt;/Grid.ColumnDefinitions&gt;&#10;    &lt;TextBlock Text=&quot;Framework&quot; FontWeight=&quot;SemiBold&quot; /&gt;&#10;    &lt;TextBlock Grid.Column=&quot;1&quot; Text=&quot;WinUI 3&quot; /&gt;&#10;    &lt;TextBlock Grid.Row=&quot;1&quot; Text=&quot;Runtime&quot; FontWeight=&quot;SemiBold&quot; /&gt;&#10;    &lt;TextBlock Grid.Row=&quot;1&quot; Grid.Column=&quot;1&quot; Text=&quot;.NET 10&quot; /&gt;&#10;&lt;/Grid&gt;">
                    <Grid ColumnSpacing="16" RowSpacing="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Framework" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="1" Text="WinUI 3" />
                        <TextBlock Grid.Row="1" Text="Runtime" FontWeight="SemiBold" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text=".NET 10" />
                    </Grid>
                </controls:ControlExample>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
