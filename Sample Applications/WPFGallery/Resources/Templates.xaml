<ResourceDictionary x:Class="WPFGallery.Resources.Templates"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:WPFGallery.Models"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls">
    <ItemsPanelTemplate x:Key="WrapPanelTemplate">
        <toolkit:WrapPanel Margin="10" Orientation="Horizontal" />
    </ItemsPanelTemplate>
    <DataTemplate x:Key="NavigationCardTemplate" x:DataType="models:ControlInfoDataItem">
        <Button AutomationProperties.AutomationId="{x:Bind Title}" Width="360" MinHeight="90" Margin="7" Padding="20,10"
                HorizontalContentAlignment="Stretch"
                AutomationProperties.Name="{x:Bind Title}"
                Click="NavigationCard_Click">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="50" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Image Source="{x:Bind ImageUri}" Width="50" Height="50" />
                <StackPanel Grid.Column="1" Spacing="4">
                    <TextBlock Text="{x:Bind Title}" Style="{StaticResource BodyStrongTextBlockStyle}"
                               AutomationProperties.HeadingLevel="Level3" />
                    <TextBlock Text="{x:Bind Description}" Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
        </Button>
    </DataTemplate>
</ResourceDictionary>
